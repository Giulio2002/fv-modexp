#!/usr/bin/env python3
"""check-ra-pin: RA-pin self-audit prep (BRIEF "RETURN-ADDRESS PIN GAP"; top s37).

NOT a release gate since Janus v0.4.0: `Ensures` evaluates the precondition before the return address is installed
(`State.setRet`), so no precondition can constrain it. Kept as a review aid.
For every row module (lean/FvModexp/{Arm64,Amd64,Proofs}/**.lean with `theorem correctness`) elaborate scripts/RaPin.lean's
`#ra_pin_audit` on the row's `correctness`: the precondition of every Janus main-theorem form, with every fv-modexp
definition/structure unfolded, split into conjuncts and classified against the probe forms of
Janus v0.3.3's return-address probe forms (RspBypass64, LrPin; reproduced in scripts/lint-tests/rapin/) (FLAG = the manual audit must read it; INFO = listed only).
This is a CHECKLIST GENERATOR for the final gate's manual audit, not a verdict: the auditor still reads every FLAG line and
the RSP-REL / STACK-ARG / FRAMEWORK lines of each row.

Usage (from anywhere):  scripts/check-ra-pin [--selftest] [--isa arm64|amd64] [-j N] [ROW_SUBSTRING ...]
  Imports the dev oleans (lean/.lake/build + build/dev/<isa>/Extracted.olean, RequiredGas: build/dev-<isa>-RequiredGas):
  run a dev sweep (or `janus verify`) first so they are current. Each row: one `lean` process under memcap 8G.
  --selftest: run the probe forms (scripts/lint-tests/rapin/Probes{64,Arm}.lean) and check every `-- expect:` verdict.
  --oleans CONSUMER (top s52): use a `janus verify` release cache instead of the dev oleans: CONSUMER = <JANUS_CACHE_DIR>/v1/consumer/<h>/<h>
  of the Run extraction (LEAN_PATH = own/lib/root : own/lib/deps/ethlibspec : janus/.lake/build/lib/lean : toolchain); --rg-oleans CONSUMER
  likewise for the RequiredGas extraction (RequiredGas rows are skipped, and listed, without it). --release: only the rows of
  scripts/release-rows.txt (for the ISA given by --isa, or both).
Output: build/rapin/report.txt (all rows) + per-row build/rapin/<isa>-<row>.out; exit 1 if any row has a FLAG or fails.
"""
import os, re, subprocess, sys, concurrent.futures as cf

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LEAN = os.path.join(ROOT, 'lean')
OUT = os.path.join(ROOT, 'build', 'rapin')
TOOL = open(os.path.join(ROOT, 'scripts', 'RaPin.lean')).read()


def rows():
    res = []
    walk = [w for b in ('Proofs', 'Arm64', 'Amd64') for w in os.walk(os.path.join(LEAN, 'FvModexp', b))]
    for d, _, fs in walk:
        for f in sorted(fs):
            if not f.endswith('.lean'):
                continue
            p = os.path.join(d, f)
            rel = os.path.relpath(p, LEAN)
            isa = 'arm64' if '/Arm64/' in rel else 'amd64' if '/Amd64/' in rel else None
            if isa is None:
                continue   # Warmup / Common: no row
            stack, thm = [], None
            for line in open(p):
                m = re.match(r'namespace\s+(\S+)', line)
                if m:
                    stack.append(m.group(1)); continue
                m = re.match(r'end\s+(\S+)\s*$', line)
                if m and stack and stack[-1] == m.group(1):
                    stack.pop(); continue
                # main theorems: `correctness` or `correctness_<x>` (Janus mainsNamed; e.g. RunTotal's correctness_total),
                # never the `Witness.*` existentials
                m = re.match(r'theorem\s+(correctness(?:_\w+)?)(\s|$)', line)
                if m and not (stack and stack[-1].endswith('Witness')):
                    thm = '.'.join(stack + [m.group(1)])
                    break
            if thm:
                mod = rel[:-5].replace('/', '.')
                res.append((isa, mod, thm, rel))
    return sorted(res)


def dev_path(isa, rel):
    if '/RequiredGas' in rel:
        return os.path.join(ROOT, 'build', f'dev-{isa}-RequiredGas')
    return os.path.join(ROOT, 'build', 'dev', isa)


OLEANS = {}     # 'run' / 'rg' -> consumer dir (--oleans / --rg-oleans)
TC = '/root/.elan/toolchains/leanprover--lean4---v4.34.1'


def run_one(isa, mod, body, cmds, tag, rel):
    os.makedirs(OUT, exist_ok=True)
    src = os.path.join(OUT, f'{tag}.lean')
    with open(src, 'w') as fh:
        fh.write('import Lean\nimport ' + mod + '\n' + TOOL + '\n' + body + '\n' + cmds + '\n')
    cons = OLEANS.get('rg' if '/RequiredGas' in rel else 'run')
    if cons:
        lp = ':'.join([f'{cons}/own/lib/root', f'{cons}/own/lib/deps/ethlibspec', f'{cons}/janus/.lake/build/lib/lean', f'{TC}/lib/lean'])
        r = subprocess.run(['memcap', '-m', '8G', f'{TC}/bin/lean', src], cwd=LEAN, capture_output=True, text=True, timeout=900,
                           env=dict(os.environ, LEAN_PATH=lp))
    else:
        dev = dev_path(isa, rel)
        cmd = ['memcap', '-m', '8G', 'lake', 'env', 'bash', '-c',
               f'LEAN_PATH=$LEAN_PATH:{dev} exec lean {src}']
        r = subprocess.run(cmd, cwd=LEAN, capture_output=True, text=True, timeout=900)
    out = r.stdout + r.stderr
    with open(os.path.join(OUT, f'{tag}.out'), 'w') as fh:
        fh.write(out)
    return r.returncode, out


def parse(out):
    """{theorem: verdict} from RAPIN lines; errors (other than sorry warnings) make the row fail."""
    v = {}
    for line in out.splitlines():
        m = re.match(r'RAPIN \S+ (\S+): (.*)$', line)
        if m:
            v[m.group(1)] = m.group(2)
    errs = [l for l in out.splitlines() if ': error' in l]
    return v, errs


def selftest():
    ok = True
    for isa, f, imp in (('amd64', 'Probes64.lean', 'Extracted'), ('arm64', 'ProbesArm.lean', 'Extracted')):
        p = os.path.join(ROOT, 'scripts', 'lint-tests', 'rapin', f)
        text = open(p).read()
        ns = re.search(r'namespace\s+(\S+)', text).group(1)
        exp = re.findall(r'-- expect: (FLAG|CLEAN)[^\n]*\ntheorem\s+(\S+)', text)
        cmds = '\n'.join(f'#ra_pin_audit {ns}.{t} "{isa}"' for _, t in exp)
        rc, out = run_one(isa, imp, text, cmds, f'selftest-{isa}', '')
        v, errs = parse(out)
        for e, t in exp:
            got = v.get(f'{ns}.{t}', 'MISSING')
            good = (got == 'CLEAN') if e == 'CLEAN' else ('FLAG' in got)
            ok &= good
            print(f'selftest {isa} {t}: expect {e}, got {got} {"ok" if good else "WRONG"}')
        for e in errs:
            ok = False; print('selftest error:', e)
    print('SELFTEST', 'PASS' if ok else 'FAIL')
    return 0 if ok else 1


def main():
    args = sys.argv[1:]
    if '--selftest' in args:
        sys.exit(selftest())
    isa_f, j, pats, release, nmiss = None, 2, [], False, 0
    i = 0
    while i < len(args):
        if args[i] == '--isa':
            isa_f = args[i + 1]; i += 2
        elif args[i] in ('--oleans', '--rg-oleans'):
            OLEANS['run' if args[i] == '--oleans' else 'rg'] = os.path.abspath(args[i + 1]); i += 2
        elif args[i] == '--release':
            release = True; i += 1
        elif args[i] == '-j':
            j = int(args[i + 1]); i += 2
        else:
            pats.append(args[i]); i += 1
    rs = [r for r in rows() if (isa_f is None or r[0] == isa_f) and (not pats or any(p in r[3] for p in pats))]
    if release:
        rel_rows = set()
        for l in open(os.path.join(ROOT, 'scripts', 'release-rows.txt')):
            p = l.split('#', 1)[0].split()
            if len(p) == 2:
                d = {'arm64': 'Arm64', 'amd64': 'Amd64'}[p[0]]
                claim = f"FvModexp/{d}/{p[1]}.lean"
                rel_rows.add(claim if os.path.isfile(os.path.join(LEAN, claim)) else f"FvModexp/Proofs/{d}/{p[1]}.lean")
        missing = sorted(x for x in rel_rows if x not in {r[3] for r in rows()}
                         and (isa_f is None or ('/Arm64/' in x) == (isa_f == 'arm64')))
        for x in missing:
            print(f'FAIL: release row without a `theorem correctness` module: {x}')
        nmiss = len(missing)
        rs = [r for r in rs if r[3] in rel_rows]
    if OLEANS and 'rg' not in OLEANS:
        for r in [r for r in rs if '/RequiredGas' in r[3]]:
            print(f'{r[0]} {r[3]}: SKIPPED (no --rg-oleans)')
        rs = [r for r in rs if '/RequiredGas' not in r[3]]

    def job(r):
        isa, mod, thm, rel = r
        tag = f'{isa}-' + rel.replace('/Proofs/', '/')[:-5].split('/', 2)[2].replace('/', '_')
        try:
            rc, out = run_one(isa, mod, '', f'#ra_pin_audit {thm} "{isa}"', tag, rel)
        except subprocess.TimeoutExpired:
            return r, 'TIMEOUT', ''
        v, errs = parse(out)
        verdict = v.get(thm, 'ERROR') if not errs else 'ERROR: ' + errs[0][:200]
        return r, verdict, out

    results = []
    with cf.ThreadPoolExecutor(max_workers=j) as ex:
        for r, verdict, out in ex.map(job, rs):
            print(f'{r[0]} {r[3]}: {verdict}', flush=True)
            results.append((r, verdict, out))
    os.makedirs(OUT, exist_ok=True)
    bad = 0
    with open(os.path.join(OUT, 'report.txt'), 'w') as fh:
        fh.write('check-ra-pin report (checklist for the final-gate manual RA-pin audit; probe forms: '
                 'Janus v0.3.3 RspBypass64 / LrPin, see scripts/lint-tests/rapin/)\n\n')
        for r, verdict, out in results:
            if verdict != 'CLEAN':
                bad += 1
            fh.write(f'=== {r[0]} {r[3]} ({r[2]}): {verdict}\n')
            fh.write('\n'.join(l for l in out.splitlines() if l.startswith(('RAPIN', ' form', '  '))) + '\n\n')
    bad += nmiss
    print(f'{len(results)} rows, {len(results) - bad + nmiss} CLEAN, {bad} need attention; report {OUT}/report.txt')
    sys.exit(1 if bad else 0)


if __name__ == '__main__':
    main()
