#!/usr/bin/env python3
"""check-generated [FILE...] -- (agent infra) re-run scripts/gen-libprog-sub.py for every restricted-program module it
generated (lean/FvModexp/Proofs/*/**.lean whose header says "GENERATED by scripts/gen-libprog-sub.py") with the module's own
names list and doc header, against the pinned Run extraction /srv/fv-modexp/build/x-Run-<isa>/Extracted.lean, and fail if
any output differs from the committed file. Modules from the older generator version (no `mask0` theorem; `eq_only` by
congr) are skipped and counted."""
import sys, re, os, glob, subprocess, tempfile
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
files = sys.argv[1:] or sorted(glob.glob(os.path.join(root, "lean/FvModexp/Proofs/**/*.lean"), recursive=True))
bad = 0; n = 0; legacy = 0
for f in files:
    t = open(f).read()
    m = re.search(r"/-! (.*?)GENERATED by scripts/gen-libprog-sub.py \((arm64|amd64), pinned Run extraction\)", t, re.S)
    if not m: continue
    doc, isa = m.group(1), m.group(2)
    if "theorem mask0 :" not in t and "theorem names_eq :" not in t: legacy += 1; continue   # emitted by the pre-mask generator version (congr proof)
    name = re.search(r"^namespace FvModexp\.(?:Arm64|Amd64)\.(\S+)$", t, re.M).group(1)
    names = re.findall(r'"([^"]+)"', re.search(r"^def names : List String := \[(.*?)\]$", t, re.M).group(1))
    env = dict(os.environ, KEEPALL="1")
    env.pop("DOC", None)
    if doc: env["DOC"] = doc[:-1] if doc.endswith("\n") else doc
    with tempfile.TemporaryDirectory() as d:
        out = os.path.join(d, "o.lean")
        subprocess.run([sys.executable, os.path.join(root, "scripts/gen-libprog-sub.py"),
                        f"/srv/fv-modexp/build/x-Run-{isa}/Extracted.lean", isa, name, out] + names, env=env, check=True)
        ok = open(out).read() == t
    n += 1
    if not ok: bad += 1; print("DIFFERS:", os.path.relpath(f, root))
print(f"check-generated: {n} modules checked, {bad} differ ({legacy} legacy pre-mask modules skipped)"); sys.exit(1 if bad else 0)
