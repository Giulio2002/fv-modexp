import FvModexp.Proofs.Amd64.Exp.W2Pow

set_option autoImplicit false

/-!
# window-2 prologue (amd64): the table loop `i = 2 … 3` (nat.go:1420-1421; agent expmc s49)

Induction on `4 - i` over `powStep`, from the head (`AX = i`) to the exit `j4` (`AX = 4`).
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic Janus.Contracts FvModexp

namespace FvModexp.Amd64.W2Pro

set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
theorem powLoop {impl : List Amd64.Segment} (hap : Amd64.ImplApart Extracted.program impl) {R : RtInv}
    (hclr : MemclrNoHeapPointersLive64 (Extracted.program.ofImpl impl)
      (Extracted.program.contractAddr "runtime.memclrNoHeapPointers") 4096 R)
    (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (Extracted.program.contractAddr "runtime.memmove") 4096 R)
    {b : Nat} {L : List (Nat × Nat)} {g fs sp n mp mc k0 bp bc : Nat} {M0 : Memory}
    (hs : PStatic R L g fs sp n mp mc k0 bp bc M0) {tbl : Nat → Nat} {ret : W64} {Q : State → Prop} {r5 : W64}
    (htbl : ∀ i, 2 ≤ i → i < 4 → tbl i = Exp.montgomery n (tbl (i - 1)) (tbl 1) (M0.readLE mp (8 * n)) k0)
    (KX : ∀ S' : State, S'.rip = BitVec.ofNat 64 j4 → S'.regs 4 = BitVec.ofNat 64 sp → S'.regs 5 = r5 →
      S'.regs 14 = BitVec.ofNat 64 g → S'.fsBase.toNat = fs → S'.xmm 15 = 0 → S'.df = false →
      FP R L sp bp bc M0 S'.mem → R.inv b L g (view R.rt L S'.mem) → S'.mem.regions = M0.regions →
      PSl sp n mp mc k0 bp bc S'.mem → (∀ d, d < 4 → Ent sp n (tp bp n) (tc n) tbl S'.mem d) →
      ReachesRet (LibW.program.link impl) ret S' Q) :
    ∀ (f i : Nat) (S : State), f = 4 - i → 2 ≤ i → i ≤ 4 →
      S.rip = BitVec.ofNat 64 powHead → S.regs 4 = BitVec.ofNat 64 sp → S.regs 0 = BitVec.ofNat 64 i →
      S.regs 5 = r5 → S.regs 14 = BitVec.ofNat 64 g → S.fsBase.toNat = fs → S.xmm 15 = 0 → S.df = false →
      FP R L sp bp bc M0 S.mem → R.inv b L g (view R.rt L S.mem) → S.mem.regions = M0.regions →
      PSl sp n mp mc k0 bp bc S.mem → (∀ d, d < i → Ent sp n (tp bp n) (tc n) tbl S.mem d) →
      ReachesRet (LibW.program.link impl) ret S Q := by
  intro f
  induction f with
  | zero =>
    intro i S hf hi2 hi16 hpc hsp h0 h5 h14 hfs hx15 hdf hF hinv hrg hsl hE
    have hi : i = 4 := by omega
    subst hi
    have hacc : S.mem.accessible (sp - 4296) (4296 + 0x2a8) true = true := by
      rw [hF.1.accessible]; exact hs.1.2.2.2.1
    janus64_run [] until [j4]
    exact KX _ rfl hsp h5 h14 hfs hx15 rfl hF hinv hrg hsl hE
  | succ f ih =>
    intro i S hf hi2 hi16 hpc hsp h0 h5 h14 hfs hx15 hdf hF hinv hrg hsl hE
    refine powStep hap hclr hmv hs i S hi2 (by omega) hpc hsp h0 h5 h14 hfs hx15 hdf hF hinv hrg hsl hE ?_
    intro S' a1 a2 a3 a4 a5 a6 a7 a8 hF' hinv' hrg' hsl' hE' hEi
    refine ih (i + 1) S' (by omega) (by omega) (by omega) a1 a2 a3 a4 a5 a6 a7 a8 hF' hinv' hrg' hsl' ?_
    intro d hd
    rcases Nat.lt_succ_iff_lt_or_eq.1 hd with hd | rfl
    · exact hE' d hd
    · exact ⟨hEi.1.trans (htbl d hi2 (by omega)).symm, hEi.2⟩

end FvModexp.Amd64.W2Pro
