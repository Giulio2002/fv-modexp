import FvModexp.Proofs.Amd64.Nat.NatAddVW
import FvModexp.Proofs.Amd64.Nat.NatAddVV
import FvModexp.Proofs.Amd64.Nat.NatAddReuse
import FvModexp.Proofs.Amd64.Nat.NatAddAlloc

set_option autoImplicit false

/-!
# `nat.add` (amd64): composition of the independent segment modules

`vv` = `vvH` with `afterVV`; `reuse` / `alloc` = `reuseH` / `allocH` with `vv` (statements unchanged from the former
sequential chain; ROW-TIME LESSON, divmc s32). `ReuseStmt` / `AllocStmt` generated by scripts/gen/stmt-of-thm.py.
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.GoABI0 Janus.Amd64.Tactic Janus.Spec Janus.Contracts
open FvModexp.Amd64.Callees Janus.Contracts.EqHashModel

namespace FvModexp.Amd64.NatAdd

theorem vv (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv)
    (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : VVStmt impl hap R hmv :=
  vvH impl hap R hmv (afterVV impl hap R hmv)

@[reducible] def ReuseStmt (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv) (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : Prop :=
    ∀ (b : Nat) (L : List (Nat × Nat)) (zp zl zc xp xl xc yp yl yc : BitVec 64) (s : State)
      (he : Entry s zp zl zc xp xl xc yp yl yc) (hyx : yl.toNat ≤ xl.toNat) (hy0 : 0 < yl.toNat) (hz : xl.toNat + 1 ≤ zc.toNat)
      (hpre : PreS 4288 R b L zp zc xp xl xc yp yl yc s),
      ReachesRet (LibNatAdd.program.link impl) (retAddrOf s) s fun s' =>
        RegsOK s s' ∧ PostX 4288 R b L zp zc xp xl yp yl s s'

theorem reuse (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv)
    (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : ReuseStmt impl hap R hmv :=
  reuseH impl hap R hmv (vv impl hap R hmv)

@[reducible] def AllocStmt (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv) (hmk : MakesliceLiveContract64 (LibNatAdd.program.link impl) (cA "runtime.makeslice") 4096 R) (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : Prop :=
    ∀ (b : Nat) (L : List (Nat × Nat)) (zp zl zc xp xl xc yp yl yc : BitVec 64) (s : State)
      (he : Entry s zp zl zc xp xl xc yp yl yc) (hyx : yl.toNat ≤ xl.toNat) (hy0 : 0 < yl.toNat) (hz : zc.toNat < xl.toNat + 1)
      (hpre : PreS 4288 R b L zp zc xp xl xc yp yl yc s),
      ReachesRet (LibNatAdd.program.link impl) (retAddrOf s) s fun s' =>
        RegsOK s s' ∧ PostX 4288 R b L zp zc xp xl yp yl s s'

theorem alloc (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv)
    (hmk : MakesliceLiveContract64 (LibNatAdd.program.link impl) (cA "runtime.makeslice") 4096 R)
    (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : AllocStmt impl hap R hmk hmv :=
  allocH impl hap R hmk hmv (vv impl hap R hmv)

end FvModexp.Amd64.NatAdd
