import FvModexp.Proofs.Amd64.Nat.NatSubMid

set_option autoImplicit false

/-!
# `nat.sub` (amd64): the continuation statements of the segment lemmas

`VVStmt` (= the statement of `vv`, from `+0x13d` on) and `AfterVVStmt` (= `afterVV`, after `subVV.abi0`), so that the
entry paths (`reuse`, `alloc`) and `vv` are proved in independent modules that take the continuation as a hypothesis; the
composition is `NatSubComp` (ROW-TIME LESSON; divmc s32). Generated by scripts/gen/stmt-of-thm.py from the theorem headers.
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.GoABI0 Janus.Amd64.Tactic Janus.Spec Janus.Contracts
open FvModexp.Amd64.Callees Janus.Contracts.EqHashModel

namespace FvModexp.Amd64.NatSub

/-- The return site of `subVV.abi0`. -/
abbrev hAfterVV : Nat := segAddr Extracted.program fn + 0x189

/-- The entry facts of every path lemma (amd64): the registers and the ABI part of a call. -/
@[reducible] def Entry (s : State) (zp zl zc xp xl xc yp yl yc : BitVec 64) : Prop :=
  s.rip = BitVec.ofNat 64 (segAddr Extracted.program fn) ∧ s.mem.readLE (s.regs 4).toNat 8 < 2 ^ 47 ∧
    s.xmm 15 = 0#128 ∧ s.df = false ∧ s.regs 0 = zp ∧ s.regs 3 = zl ∧ s.regs 1 = zc ∧ s.regs 7 = xp ∧
    s.regs 6 = xl ∧ s.regs 8 = xc ∧ s.regs 9 = yp ∧ s.regs 10 = yl ∧ s.regs 11 = yc

@[reducible] def AfterVVStmt (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv) (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : Prop :=
    ∀ (b : Nat) (L : List (Nat × Nat)) (zp zc xp xl xc yp yl : BitVec 64) (s : State)
      (p c : Nat) (L' : List (Nat × Nat)) (b' : Nat) (M : Janus.Arm64.Memory)
      (h : Mid R b L zp zc xp xl xc yp yl s p c L' b' M) (hyx : yl.toNat ≤ xl.toNat) (hy0 : 0 < yl.toNat) (hxc : xl.toNat ≤ xc.toNat)
      (hxc63 : xc.toNat < 2 ^ 63) (hps : M.readLE ((s.regs 4).toNat - 24) 8 = p) (hcs : M.readLE ((s.regs 4).toNat - 56) 8 = c) (hms : M.readLE ((s.regs 4).toNat - 64) 8 = xl.toNat)
      (hlo : natVal M p yl.toNat + natVal s.mem yp.toNat yl.toNat =
      natVal s.mem xp.toNat yl.toNat + 2 ^ (64 * yl.toNat) * M.readLE ((s.regs 4).toNat - 72) 8) (hb1 : M.readLE ((s.regs 4).toNat - 72) 8 ≤ 1) (hge : natVal s.mem yp.toNat yl.toNat ≤ natVal s.mem xp.toNat xl.toNat) (hhi : natVal M (xp.toNat + 8 * yl.toNat) (xl.toNat - yl.toNat) =
      natVal s.mem (xp.toNat + 8 * yl.toNat) (xl.toNat - yl.toNat))
      (S : State) (hpc : S.rip = BitVec.ofNat 64 hAfterVV) (hsp : S.regs 4 = s.regs 4 - 144#64) (h5 : S.regs 5 = s.regs 4 - 8#64)
      (hfs : S.fsBase = s.fsBase) (hdf : S.df = false) (hm : S.mem = M),
      ReachesRet (LibNatSub.program.link impl) (retAddrOf s) S fun s' =>
        RegsOK s s' ∧ PostX 4288 R b L zp zc xp xl yp yl s s'

@[reducible] def VVStmt (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv) (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R) : Prop :=
    ∀ (b : Nat) (L : List (Nat × Nat)) (zp zc xp xl xc yp yl yc : BitVec 64) (s : State)
      (p c : Nat) (L' : List (Nat × Nat)) (b' : Nat) (M : Janus.Arm64.Memory)
      (h : Mid R b L zp zc xp xl xc yp yl s p c L' b' M) (hyx : yl.toNat ≤ xl.toNat) (hy0 : 0 < yl.toNat) (hxc : xl.toNat ≤ xc.toNat)
      (hxc63 : xc.toNat < 2 ^ 63) (hvx : natVal M xp.toNat yl.toNat = natVal s.mem xp.toNat yl.toNat) (hvh : natVal M (xp.toNat + 8 * yl.toNat) (xl.toNat - yl.toNat) =
      natVal s.mem (xp.toNat + 8 * yl.toNat) (xl.toNat - yl.toNat)) (hvy : natVal M yp.toNat yl.toNat = natVal s.mem yp.toNat yl.toNat)
      (hge : natVal s.mem yp.toNat yl.toNat ≤ natVal s.mem xp.toNat xl.toNat) (S : State) (hpc : S.rip = BitVec.ofNat 64 hMid) (h0 : S.regs 0 = BitVec.ofNat 64 p)
      (h1 : S.regs 1 = BitVec.ofNat 64 c) (h6 : S.regs 6 = xl) (h7 : S.regs 7 = xp) (h8 : S.regs 8 = xc)
      (h9 : S.regs 9 = yp) (h10 : S.regs 10 = yl) (h11 : S.regs 11 = yc) (hsp : S.regs 4 = s.regs 4 - 144#64)
      (h14 : S.regs 14 = s.regs 14) (h5 : S.regs 5 = s.regs 4 - 8#64) (hfs : S.fsBase = s.fsBase) (hdf : S.df = false)
      (hm : S.mem = M),
      ReachesRet (LibNatSub.program.link impl) (retAddrOf s) S fun s' =>
        RegsOK s s' ∧ PostX 4288 R b L zp zc xp xl yp yl s s'

end FvModexp.Amd64.NatSub
