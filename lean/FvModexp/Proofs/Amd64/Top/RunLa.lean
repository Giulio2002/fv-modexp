open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic Janus.Spec Janus.Contracts

namespace FvModexp.Amd64.Run

set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
theorem la (impl : List Amd64.Segment) (hap : ImplApart Extracted.program impl) (R : RtInv)
    (b : Nat) (L : List (Nat × Nat)) (c p len cp : BitVec 64) (ret : Nat)
    (hret : RetAddr (LibRun.program.link impl) ret) (s : State)
    (henv : CallEnv R L s stk 40) (Q : Janus.Amd64.Outcome → Prop)
    (S : State) (L1 : List (Nat × Nat)) (b1 : Nat) (hrel : RelH R b L c p len cp s ret 3 L1 b1 S)
    (hpc : S.rip = BitVec.ofNat 64 pcB3)
    (hr0 : (S.regs 0).toNat = S.mem.readLE ((s.regs 4).toNat - 96) 8)
    (hr3 : (S.regs 3).toNat = S.mem.readLE ((s.regs 4).toNat - 88) 8)
    (hk : ∀ T : State, T.rip = BitVec.ofNat 64 pcP1 → T.mem = S.mem → T.regs 4 = S.regs 4 → T.regs 14 = S.regs 14 →
      T.regs 5 = S.regs 5 → T.xmm 15 = S.xmm 15 → T.fsBase = S.fsBase → T.df = S.df →
      LenRegs (hdrV s p len 0) (T.regs 2) (T.regs 10) → LenRegs (hdrV s p len 1) (T.regs 9) (T.regs 13) →
      LenRegs (hdrV s p len 2) (T.regs 11) (T.regs 0) →
      Reaches ((LibRun.program.link impl).withExit ret) T Q) :
    Reaches ((LibRun.program.link impl).withExit ret) S Q := by
  by_cases hz0 : S.mem.readLE ((s.regs 4).toNat - 24) 8 = 0 <;> by_cases hz1 : S.mem.readLE ((s.regs 4).toNat - 56) 8 = 0 <;>
    by_cases hz2 : S.mem.readLE ((s.regs 4).toNat - 88) 8 = 0
  · exact laTTT impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laTTF impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laTFT impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laTFF impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laFTT impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laFTF impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laFFT impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk
  · exact laFFF impl hap R b L c p len cp ret hret s henv Q S L1 b1 hrel hpc hz0 hz1 hz2 hr0 hr3 hk

