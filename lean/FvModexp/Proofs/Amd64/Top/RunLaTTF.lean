set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
theorem laTTF (impl : List Amd64.Segment) (hap : ImplApart Extracted.program impl) (R : RtInv)
    (b : Nat) (L : List (Nat × Nat)) (c p len cp : BitVec 64) (ret : Nat)
    (hret : RetAddr (LibRun.program.link impl) ret) (s : State)
    (henv : CallEnv R L s stk 40) (Q : Janus.Amd64.Outcome → Prop)
    (S : State) (L1 : List (Nat × Nat)) (b1 : Nat) (hrel : RelH R b L c p len cp s ret 3 L1 b1 S)
    (hpc : S.rip = BitVec.ofNat 64 pcB3) (hz0 : S.mem.readLE ((s.regs 4).toNat - 24) 8 = 0) (hz1 : S.mem.readLE ((s.regs 4).toNat - 56) 8 = 0) (hz2 : S.mem.readLE ((s.regs 4).toNat - 88) 8 ≠ 0)
    (hr0 : (S.regs 0).toNat = S.mem.readLE ((s.regs 4).toNat - 96) 8)
    (hr3 : (S.regs 3).toNat = S.mem.readLE ((s.regs 4).toNat - 88) 8)
    (hk : ∀ T : State, T.rip = BitVec.ofNat 64 pcP1 → T.mem = S.mem → T.regs 4 = S.regs 4 → T.regs 14 = S.regs 14 →
      T.regs 5 = S.regs 5 → T.xmm 15 = S.xmm 15 → T.fsBase = S.fsBase → T.df = S.df →
      LenRegs (hdrV s p len 0) (T.regs 2) (T.regs 10) → LenRegs (hdrV s p len 1) (T.regs 9) (T.regs 13) →
      LenRegs (hdrV s p len 2) (T.regs 11) (T.regs 0) →
      Reaches ((LibRun.program.link impl).withExit ret) T Q) :
    Reaches ((LibRun.program.link impl).withExit ret) S Q := by
  obtain ⟨hg, ⟨hb', ha, hw⟩, hal, hd, hout, hga, hgr, hLs, hro, htls⟩ := henv
  obtain ⟨hsp, h14, h5, hx15, hfs, hdf, hm1, hm2, hm3, hm4, hm5, hm6, -, -, -, -, -, -, -, -, hMF, -, hhd⟩ := hrel
  have hS : ∀ a n w, S.mem.accessible a n w = s.mem.accessible a n w := hMF.accessible
  simp only [stk, regSP] at hb' ha hw
  have e0 : hdrAt s 0 = (s.regs 4).toNat - 32 := by simp only [hdrAt]; omega
  have e1 : hdrAt s 1 = (s.regs 4).toNat - 64 := by simp only [hdrAt]; omega
  have e2 : hdrAt s 2 = (s.regs 4).toNat - 96 := by simp only [hdrAt]; omega
  have f0 : (s.regs 4).toNat - 32 + 8 = (s.regs 4).toNat - 24 := by omega
  have f1 : (s.regs 4).toNat - 64 + 8 = (s.regs 4).toNat - 56 := by omega
  have f2 : (s.regs 4).toNat - 96 + 8 = (s.regs 4).toNat - 88 := by omega
  have hA : ∀ k, k < 3 → S.mem.readLE (hdrAt s k + 8) 8 ≠ 0 →
      S.mem.accessible (S.mem.readLE (hdrAt s k) 8) (8 * S.mem.readLE (hdrAt s k + 8) 8) false = true ∧
      S.mem.readLE (hdrAt s k) 8 + 8 * S.mem.readLE (hdrAt s k + 8) 8 ≤ 2 ^ 48 := by
    intro k hk hn
    obtain ⟨⟨-, -, -, hcl⟩, -, hac⟩ := hhd k hk
    obtain ⟨-, h2, h3⟩ := hac (by omega)
    refine ⟨Janus.Arm64.Memory.accessible_read_of_write _ ?_, by omega⟩
    rw [hS]; exact Janus.Arm64.Memory.accessible_mono _ h2 (Nat.le_refl _) (by omega)
  have hV0 : hdrV s p len 0 = natVal S.mem (S.mem.readLE ((s.regs 4).toNat - 32) 8) (S.mem.readLE ((s.regs 4).toNat - 24) 8) := by
    have := (hhd 0 (by omega)).1.1; simp only [natAt] at this; rw [e0, f0] at this; exact this.symm
  have hN0 : NatNorm S.mem (S.mem.readLE ((s.regs 4).toNat - 32) 8) (S.mem.readLE ((s.regs 4).toNat - 24) 8) := by
    have := (hhd 0 (by omega)).1.2.1; rw [e0, f0] at this; exact this
  have hl0 : S.mem.readLE ((s.regs 4).toNat - 24) 8 ≤ 4 := by
    have := (hhd 0 (by omega)).1.2.2.1; rw [e0, f0] at this; exact this
  have hV1 : hdrV s p len 1 = natVal S.mem (S.mem.readLE ((s.regs 4).toNat - 64) 8) (S.mem.readLE ((s.regs 4).toNat - 56) 8) := by
    have := (hhd 1 (by omega)).1.1; simp only [natAt] at this; rw [e1, f1] at this; exact this.symm
  have hN1 : NatNorm S.mem (S.mem.readLE ((s.regs 4).toNat - 64) 8) (S.mem.readLE ((s.regs 4).toNat - 56) 8) := by
    have := (hhd 1 (by omega)).1.2.1; rw [e1, f1] at this; exact this
  have hl1 : S.mem.readLE ((s.regs 4).toNat - 56) 8 ≤ 4 := by
    have := (hhd 1 (by omega)).1.2.2.1; rw [e1, f1] at this; exact this
  have hV2 : hdrV s p len 2 = natVal S.mem (S.mem.readLE ((s.regs 4).toNat - 96) 8) (S.mem.readLE ((s.regs 4).toNat - 88) 8) := by
    have := (hhd 2 (by omega)).1.1; simp only [natAt] at this; rw [e2, f2] at this; exact this.symm
  have hN2 : NatNorm S.mem (S.mem.readLE ((s.regs 4).toNat - 96) 8) (S.mem.readLE ((s.regs 4).toNat - 88) 8) := by
    have := (hhd 2 (by omega)).1.2.1; rw [e2, f2] at this; exact this
  have hl2 : S.mem.readLE ((s.regs 4).toNat - 88) 8 ≤ 4 := by
    have := (hhd 2 (by omega)).1.2.2.1; rw [e2, f2] at this; exact this
  have hr3' : S.regs 3 = BitVec.ofNat 64 (S.mem.readLE ((s.regs 4).toNat - 88) 8) := by
    apply BitVec.eq_of_toNat_eq; rw [hr3, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  have hr0' : S.regs 0 = BitVec.ofNat 64 (S.mem.readLE ((s.regs 4).toNat - 96) 8) := by
    apply BitVec.eq_of_toNat_eq; rw [hr0, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  clear hr0 hr3 hd hLs hro hout hga hgr
  have ⟨ha2, hb2⟩ := hA 2 (by omega) (by rw [e2, f2]; exact hz2)
  rw [e2, f2] at ha2 hb2
  have hq2 := sub_one_small64 _ (Nat.pos_of_ne_zero hz2) hl2
  have ht2 : S.mem.readLE (S.mem.readLE ((s.regs 4).toNat - 96) 8 + S.mem.readLE ((s.regs 4).toNat - 88) 8 * 8 - 8) 8 ≠ 0 := by
    have := hN2.resolve_left hz2
    rwa [show S.mem.readLE ((s.regs 4).toNat - 96) 8 + 8 * (S.mem.readLE ((s.regs 4).toNat - 88) 8 - 1) = S.mem.readLE ((s.regs 4).toNat - 96) 8 + S.mem.readLE ((s.regs 4).toNat - 88) 8 * 8 - 8 by omega] at this
  clear hA
  janus64_run [hm1, hm2, hm3, hm4, hm5, hm6, hr0', hr3', hsp, hz0, msb_m1, msb_m1', msb_allones, hz1, hq2] until [segAddr Extracted.program fn + 0x4c0]
  gen_reg 12 as y2 with hY2
  have hy2 : (y2.toNat = 0) = False := by
    rw [← hY2]; simp only [eq_iff_iff, iff_false]
    repeat (with_reducible apply bv_or_ne_left)
    exact top_ne64 ht2
  janus64_run [hr0', hr3', hsp, hz0, msb_m1, msb_m1', msb_allones, hz1, hq2, hy2] until [pcP1]
  gen_reg 11 as bl2 with hB2
  gen_reg 0 as u2 with hU2
  have k2 : 64 * (S.mem.readLE ((s.regs 4).toNat - 88) 8 - 1) < bl2.toNat ∧ bl2.toNat ≤ 64 * S.mem.readLE ((s.regs 4).toNat - 88) 8 := by
    rw [← hB2]; exact blr_val64 _ _ (by simpa using hy2) y2.isLt (Nat.pos_of_ne_zero hz2) hl2
  have hL2 : LenRegs (hdrV s p len 2) bl2 u2 := lenRegs_nz hV2 hN2 (Nat.pos_of_ne_zero hz2) hl2 k2 hU2
  refine hk _ (by janus64_simp) rfl (by janus64_simp) (by janus64_simp) (by janus64_simp) (by janus64_simp) (by janus64_simp) (by janus64_simp) ?_ ?_ ?_
  · exact lenRegs_z (by rw [hV0, hz0]; rfl) (by janus64_simp) (by janus64_simp)
  · exact lenRegs_z (by rw [hV1, hz1]; rfl) (by janus64_simp) (by janus64_simp)
  · exact hL2

end FvModexp.Amd64.Run
