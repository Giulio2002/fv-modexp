import FvModexp.Proofs.Amd64.Top.RunDKDefs
import FvModexp.Proofs.Amd64.Top.RunDSlot

/-! # `Run` (amd64): operand 1 (GENERATED by scripts/gen-run-dj1-64.py from RunDJZ0.lean), fresh `makeslice` buffer, `dst = src` — the join `J1` to the `setBytes` call `pcE1`

The `JE` is taken: the copy is skipped. This is possible only with nothing to copy (`n = 0`: a fresh object is apart
from the input when it has a byte at `src`).

At `J1` (`fn + 0x840`) the zeroed 32-byte stack buffer `e - 424` (`AX`) receives the `n = R11` available input bytes
from `src = BX` (`CMPQ AX, BX; JE` never taken: the input is outside the frame window), `memmove` returns at
`fn + 0x855`, the registers are reloaded, `e - 552 = h0 + h1` is stored and the `setBytes` arguments
`buf = (DI, SI, R8) = (buf, h1, h1)`, `z = nil` are set up. -/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic Janus.Spec Janus.Contracts

namespace FvModexp.Amd64.Run

set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
theorem dJZ1 (impl : List Amd64.Segment) (hap : ImplApart Extracted.program impl) (R : RtInv)
    (hmv : MemmoveLive64 (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R)
    (hokM : ∀ d sr n, n ≤ 2 ^ 20 → R.ok (cA "runtime.memmove") [d, sr, n])
    (b : Nat) (L : List (Nat × Nat)) (c p len cp : BitVec 64) (ret : Nat)
    (hret : RetAddr (LibRun.program.link impl) ret) (s : State) (hx0 : s.xmm 15 = 0) (hdf0 : s.df = false)
    (henv : CallEnv R L s stk 40) (hin : InputOK R L c p len cp s)
    (Q : Janus.Amd64.Outcome → Prop)
    (S : State) (L0 : List (Nat × Nat)) (bk src dst e : Nat)
    (hj : JoinE R b L c p len cp s ret 1 L0 [(dst, e)] bk dst src S) (hfr : FreshDst R s (hdrV s p len 1) dst e)
    (heq0 : dst = src)
    (hpc : S.rip = BitVec.ofNat 64 pcJ1)
    (hr6 : (S.regs 0).toNat = dst) (hr3 : (S.regs 3).toNat = src)
    (hr10 : (S.regs 11).toNat = opAvail s p len 1) (hr1 : (S.regs 1).toNat = hdrV s p len 1)
    (hk : ∀ S2, AtE R b L c p len cp s ret 1 pcE1 S2 → Reaches ((LibRun.program.link impl).withExit ret) S2 Q) :
    Reaches ((LibRun.program.link impl).withExit ret) S Q := by
  obtain ⟨hg, ⟨hb', ha, hw⟩, hal, hd, hout, hga, hgr, hLs, hro, htls⟩ := henv
  have hin0 := hin
  obtain ⟨hcacc, hc48, hcheld, hcw, hp, hlcp, hcp48, hpacc, hheld, hpw⟩ := hin
  obtain ⟨hrel, -, hzb, hsrc0, hsrc1, hsrc2, hd48, hdacc, hextL0, hsepb, hop0⟩ := hj
  obtain ⟨hfe, hfrt, hfw⟩ := hfr
  obtain ⟨hsp, h14, h5, hx15, hfs, hdf, hm1, hm2, hm3, hm4, hm5, hm6, s1, s2, s3, s4, s5, s6, l0, l1, l2, lnz, hslD, hz,
    hdS, hinS, hcS, hext, hbk, hinv, hLsS, hMF, hLF, hop, hopA⟩ := hrel
  obtain ⟨hsl, hsl2⟩ := hslD.1 (Nat.le_refl _)
  have hoL : opLen s p len 1 = hdrV s p len 1 := rfl
  have hoA : opAvail s p len 1 = min (hdrV s p len 1) (len.toNat - 96 - hdrV s p len 0) := rfl
  have hoS : opStart s p len 1 = hdrV s p len 0 := rfl
  simp only [hoL, hoA, hoS, stkBuf] at hzb hsrc1 hsrc2 hd48 hdacc hr10
  obtain ⟨hz0, hz1, hz2, hz3⟩ := hz (by decide)
  simp only [opAt] at hz0 hz1 hz2 hz3
  rw [hx0] at hx15
  rw [hdf0] at hdf
  have hmv' : MemmoveLive64 (LibRun.program.link impl) (cA "runtime.memmove") 4096 R :=
    MemmoveLive64.of_codeIn (by rw [LibRun.eq_only]; exact codeIn_ofImpl_restrict_of_apart64 hap LibRun.names) hmv
  have hLs0 := hLsS
  have hgl := hg.load
  have hg3 := hg.below
  have hg1 := hg.noWrap
  have hg2 := hg.readable
  simp only [regSP, Janus.Amd64.GoABI.regG, Janus.Amd64.GoABI.stackguard0Offset,
    Janus.Amd64.GoABI.stackguard0] at hgl hg3 hg1 hg2 hb' ha hw hout hal hga hgr
  simp only [stk] at hg3 hb' ha hw hout hga hLs hpw hcw hLsS hMF
  obtain ⟨⟨hfs8, hfsacc, hfsg⟩, hfsrt, hfsw⟩ := htls
  unfold Apart at hfsw hga
  simp only [stk] at hfsw
  have hwS : S.mem.accessible ((s.regs 4).toNat - 4800) (4800 + 40) true = true := by rw [hMF.accessible]; exact hw
  have hz1' : Arm64.Memory.readLE S.mem ((s.regs 4).toNat - 160) 8 = 0 := by
    rw [show (s.regs 4).toNat - 160 = (s.regs 4).toNat - 136 - 32 * 1 + 8 by omega]; exact hz1
  have hz2' : Arm64.Memory.readLE S.mem ((s.regs 4).toNat - 152) 8 = 0 := by
    rw [show (s.regs 4).toNat - 152 = (s.regs 4).toNat - 136 - 32 * 1 + 16 by omega]; exact hz2
  have hz3' : Arm64.Memory.readLE S.mem ((s.regs 4).toNat - 144) 8 = 0 := by
    rw [show (s.regs 4).toNat - 144 = (s.regs 4).toNat - 136 - 32 * 1 + 24 by omega]; exact hz3
  have hspn : (S.regs 4).toNat = (s.regs 4).toNat - 608 := by rw [hsp]; exact toNat_sub_k (Nat.le_trans (by decide) hb') (by decide)
  simp only [LiveSep, win] at hLsS
  simp only [win, Outside, and_true] at hpw hcw
  have hLsL1 : LiveSep (L0 ++ [(dst, e)]) (win s 4800 40) := hLs0
  have hwrt : ∀ r ∈ win s 4800 40, Outside r.1 (r.2 - r.1) R.rt := fun r hr => by
    simp only [win, List.mem_cons, List.not_mem_nil, or_false] at hr; subst hr
    exact hout.of_sub (Nat.le_refl _) (win_len hb')
  have hstk : stk = 4800 := rfl
  -- the copy: `memmove(dst, src, n)`, `n = min(h1, len - 96 - h0)`
  have hn0 : min (hdrV s p len 1) (len.toNat - 96 - hdrV s p len 0) = 0 :=
    n0_of_eq' heq0 hfe hfrt hheld hextL0 hsepb (fun hn => hsrc2 hn) hsrc1 (Nat.min_le_left _ _)
  have heq : (S.regs 0 = S.regs 3) = True := eq_true (BitVec.eq_of_toNat_eq (by rw [hr6, hr3]; exact heq0))
  simp only [win, stk, Janus.outside_cons, Janus.outside_nil, and_true] at hfw
  have hLsL0 : LiveSep L0 (win s 4800 40) := fun r hr => hLsL1 r (List.mem_append_left _ hr)
  clear hpw hcw hga hfsw hokM hmv hmv' hz
  janus64_run [hr6, hr3, hr10, hr1, heq, hm1, s1, s2, s3, s4, s5, s6, hsl, hz1', hz2', hz3', hx15,
    hdf, toInt_ite, toNat_ite, BitVec.msb_eq_decide] until [pcE1]
  refine hk _ ⟨L0 ++ [(dst, e)], bk, RelD.mk' hin0 ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ l0 l1 l2 lnz ?_ ?_ ?_ hext ?_
    ?_ hLs0 ?_ ?_ ?_ ?_, by janus64_simp,
    by janus64_simp, by janus64_simp, by janus64_simp, ?buf⟩
  all_goals try (janus64_simp; done)
  all_goals try (first | (dsimp only; rw [hfs]; done) | (dsimp only; exact hdf.trans hdf0.symm; done) | (simp only [hfs]; done) | (simp only [hdf, hdf0]; done))
  case refine_19 =>
    refine ⟨fun _ => ⟨?_, ?_⟩, fun _ => ?_⟩
    · janus64_simp
    · janus64_simp [hsl2]
    · janus64_simp
  case refine_20 =>
    intro _
    refine ⟨?_, ?_, ?_, ?_⟩
    all_goals simp only [opAt]
    all_goals janus64_simp [hz0, hz1, hz2, hz3]
  case refine_21 => janus64_callpre
  case refine_22 => simp only [cstD, cstE] at hbk ⊢; exact hbk
  case refine_23 =>
    dsimp only
    rw [view_writeLE_out (hout.of_sub (buf_in_win (k := 552) (n := 8) hb' (by decide) (by decide)).1
      (buf_in_win (k := 552) (n := 8) hb' (by decide) (by decide)).2)]
    first | exact hinv | exact RtInv.inv_congr hinv rfl (by janus64_simp) rfl
  case refine_24 => dsimp only; simp only [win, stk] at hMF ⊢; janus_frame
  case refine_25 =>
    dsimp only
    exact hLF.trans (LiveFrame.of_win (by simp only [win, stk]; janus_frame) hLsL0) (fun _ _ h => hextL0.inRanges_old h)
  case refine_26 =>
    intro j hj
    rcases (show j = 0 by omega) with rfl
    refine OpDone.transportS (hop0 0 (by omega)) (k := 1) (by omega) ?_ (LiveFrame.of_win (by simp only [win, stk]; janus_frame) hLsL0) (fun _ _ h => h.append_left _)
    intro a n h1 h2; simp only [opAt] at h1 h2; janus64_simp
  case refine_27 =>
    refine OpsApart.transportS hopA ?_
    intro a n h1 h2; simp only [opAt] at h1 h2; janus64_simp
  case buf =>
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    all_goals try janus64_simp [hr6, hr1]
    · rfl
    · simp only [opV, hoS, hoL]
      rw [beVal_writeLE_disj (fresh_slot hb' (by decide) (by decide) hfw
        (by have := Nat.le_trans (Nat.le_add_right _ _) hfe; omega))]
      refine padded_val (n := 0) (mW := S.mem) (src := src) (fun i hi => absurd hi (Nat.not_lt_zero i))
        (fun h => absurd h (Nat.lt_irrefl 0)) ?_ (by omega)
      intro i _ h2
      exact hzb i h2
    · exact Janus.Arm64.Memory.accessible_read_of_write _ hdacc
    · exact hd48
    · exact Or.inl ⟨(dst, e), by simp, Nat.le_refl _, hfe⟩
    · exact (fresh_call_facts (n := hdrV s p len 1) hb' (by
        rcases hfw with h | h
        · exact Or.inl (Nat.le_trans hfe (by rw [Nat.add_sub_cancel' (Nat.le_trans (Nat.le_add_right _ _) hfe)] at h; exact h))
        · exact Or.inr h)).2.2.2

end FvModexp.Amd64.Run
