/-- `HAVE` to `ALLOC`: `X9 = roundupsize (8 c) true` (the size-class chain, or page rounding). -/
theorem chain (s T : State) {ret : W64} {Q : State → Prop} (c : Nat) (hpc : T.pc = BitVec.ofNat 64 gHAVE)
    (hP : Pre0 s T) (h5 : (T.regs 5).toNat = c) (hc0 : 0 < c) (hc : c < 2 ^ 42)
    (hk : ∀ U, Pre0 s U → U.pc = BitVec.ofNat 64 gALLOC → (U.regs 9).toNat = roundupsize (8 * c) true →
      ReachesRet grProg ret U Q) :
    ReachesRet grProg ret T Q := by
  obtain ⟨⟨hsp, h18, h28, h29, h30, hdz, htp, hfc, hfs⟩, hm, h0, h1, h2, h3⟩ := hP
  have e8 : (T.regs 5 <<< 3).toNat = 8 * c := by
    rw [BitVec.toNat_shiftLeft, h5]; simp [Nat.shiftLeft_eq]; omega
  janus_run until [gALLOC]
  all_goals have hc8 : ¬ 8 * c = 0 := by omega
  all_goals refine hk _ (by pre0_tac) rfl ?_
  · simp only [h5] at hbr ⊢
    rw [rs_large hbr]
    simp only [setReg, if_true, BitVec.toNat_mul, BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (a := (8 * c + 8191) / 8192) (by omega)]; omega
  all_goals simp only [h5] at *
  · rw [rs_small (by omega)]; simp only [setReg, if_true, BitVec.toNat_ofNat]
    exact (cs_leaf 0 _ _ (by decide) (fun x hx => Nat.lt_of_le_of_lt (show x ≤ 0 by revert x hx; decide) (by omega)) hc8 (by omega)).symm
  · rw [rs_small (by omega)]; simp only [setReg, if_true, BitVec.toNat_ofNat]
    exact (cs_leaf 1 _ _ (by decide) (fun x hx => Nat.lt_of_le_of_lt (show x ≤ 8 by revert x hx; decide) (by omega)) hc8 (by omega)).symm
  · rw [rs_small (by omega)]; simp only [setReg, if_true, BitVec.toNat_ofNat]
    exact (cs_leaf 2 _ _ (by decide) (fun x hx => Nat.lt_of_le_of_lt (show x ≤ 16 by revert x hx; decide) (by omega)) hc8 (by omega)).symm
