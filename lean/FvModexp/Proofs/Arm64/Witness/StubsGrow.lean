/-- Registers and memory a stage of the stub has not touched yet. -/
def Pre0 (s T : State) : Prop :=
  Kp s T ∧ T.mem = s.mem ∧ T.regs 0 = s.regs 0 ∧ T.regs 1 = s.regs 1 ∧ T.regs 2 = s.regs 2 ∧ T.regs 3 = s.regs 3

macro "pre0_tac" : tactic =>
  `(tactic| (refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩ <;>
    first | rfl | assumption | simp [setReg, *]))

theorem go_step (n c : Nat) : nextslicecap.go n c =
    if c + (c + 3 * 256) / 4 ≥ n then c + (c + 3 * 256) / 4 else nextslicecap.go n (c + (c + 3 * 256) / 4) := by
  rw [nextslicecap.go]

/-- The `nextslicecap` loop (`c += (c + 768) / 4` until `c ≥ newLen`), from its head with `X5 = c < newLen`. -/
theorem nsc_loop (s : State) {ret : W64} {Q : State → Prop} (tgt : Nat) (hn : (s.regs 1).toNat < 2 ^ 40)
    (hk : ∀ T, Pre0 s T → T.pc = BitVec.ofNat 64 gHAVE → (T.regs 5).toNat = tgt → ReachesRet grProg ret T Q) :
    ∀ d (T : State) (c : Nat), (s.regs 1).toNat - c = d → c < (s.regs 1).toNat →
      nextslicecap.go (s.regs 1).toNat c = tgt → T.pc = BitVec.ofNat 64 gLOOP → Pre0 s T →
      (T.regs 5).toNat = c → (T.regs 6).toNat = 4 → ReachesRet grProg ret T Q := by
  intro d
  induction d using Nat.strongRecOn with
  | ind d ih =>
  intro T c hd hc hgo hpc hP h5 h6
  obtain ⟨⟨hsp, h18, h28, h29, h30, hdz, htp, hfc, hfs⟩, hm, h0, h1, h2, h3⟩ := hP
  have h6' : T.regs 6 = 4#64 := BitVec.eq_of_toNat_eq (by simpa using h6)
  rw [go_step] at hgo
  have e7 : ((T.regs 5 + 768#64) / T.regs 6).toNat = (c + 768) / 4 := by
    rw [h6', BitVec.toNat_udiv, BitVec.toNat_add, h5]; simp; omega
  have e5 : (T.regs 5 + (T.regs 5 + 768#64) / T.regs 6).toNat = c + (c + 768) / 4 := by
    rw [BitVec.toNat_add, e7, h5]; omega
  have hn1 : (T.regs 1).toNat = (s.regs 1).toNat := by rw [h1]
  janus_run until [gLOOP, gHAVE]
  · rw [h5] at hbr
    have ev : (T.regs 5 + BitVec.ofNat 64 ((BitVec.toNat (T.regs 5) + 768) / 4)).toNat = c + (c + 768) / 4 := by
      rw [BitVec.toNat_add, BitVec.toNat_ofNat, h5]; omega
    refine ih _ (by omega) _ (c + (c + 768) / 4) rfl hbr ?_ rfl (by pre0_tac) (by simpa [setReg] using ev)
      (by simp [setReg, h6])
    rw [if_neg (by omega)] at hgo; exact hgo
  · rw [h5] at hbr
    have ev : (T.regs 5 + BitVec.ofNat 64 ((BitVec.toNat (T.regs 5) + 768) / 4)).toNat = c + (c + 768) / 4 := by
      rw [BitVec.toNat_add, BitVec.toNat_ofNat, h5]; omega
    refine hk _ (by pre0_tac) rfl ?_
    rw [if_pos (by omega)] at hgo; simpa [setReg, ← hgo] using ev

/-- Entry to `HAVE`: `X5 = nextslicecap newLen oldCap`. -/
theorem nsc_entry (s : State) {Q : State → Prop} (hpc : s.pc = BitVec.ofNat 64 E0)
    (hlt : (s.regs 2).toNat < (s.regs 1).toNat) (hn : (s.regs 1).toNat < 2 ^ 40)
    (hk : ∀ T, Pre0 s T → T.pc = BitVec.ofNat 64 gHAVE →
      (T.regs 5).toNat = nextslicecap (s.regs 1).toNat (s.regs 2).toNat → ReachesRet grProg (s.regs 30) T Q) :
    ReachesRet grProg (s.regs 30) s Q := by
  have e2 : (s.regs 2 + s.regs 2).toNat = (s.regs 2).toNat + (s.regs 2).toNat := by
    rw [BitVec.toNat_add]; omega
  janus_run until [gLOOP, gHAVE]
  · refine hk _ (by pre0_tac) rfl ?_
    simp only [setReg, if_true]; unfold nextslicecap; rw [if_pos (by omega)]
  · rename_i hbr0
    refine hk _ (by pre0_tac) rfl ?_
    simp only [setReg, if_true]; rw [e2]; unfold nextslicecap; rw [if_neg (by omega), if_pos hbr]
  · rename_i hbr0
    refine nsc_loop s _ hn hk _ _ _ rfl hlt ?_ rfl (by pre0_tac) (by simp [setReg]) (by simp [setReg])
    unfold nextslicecap; rw [if_neg (by omega), if_neg hbr]

theorem rs_small {size : Nat} (h : size ≤ 32760) : roundupsize size true = classSize size := by
  simp [roundupsize, maxSmallSize, mallocHeaderSize, h]

theorem rs_large {size : Nat} (h : 32760 < size) : roundupsize size true = (size + 8191) / 8192 * 8192 := by
  simp [roundupsize, maxSmallSize, mallocHeaderSize, pageSize]; omega

theorem fal_drop (n : Nat) : ∀ (l : List Nat) (k : Nat), (∀ x ∈ l.take k, x < n) →
    classSize.firstAtLeast l n = classSize.firstAtLeast (l.drop k) n
  | [], _, _ => by simp
  | _ :: _, 0, _ => rfl
  | c :: cs, k + 1, h => by
    have hc : c < n := h c (by simp)
    simp only [List.take_succ_cons, List.mem_cons, forall_eq_or_imp] at h
    simp only [classSize.firstAtLeast, List.drop_succ_cons, if_neg (show ¬ n ≤ c by omega)]
    exact fal_drop n cs k h.2

/-- The size class of `n` is the `k`-th class when the previous class is below `n` (classes increase). -/
theorem cs_leaf (k n c : Nat) (hc : sizeClasses.drop k = c :: sizeClasses.drop (k + 1))
    (hpre : ∀ x ∈ sizeClasses.take k, x < n) (hn0 : n ≠ 0) (hhi : n ≤ c) : classSize n = c := by
  unfold classSize
  rw [if_neg hn0, fal_drop n _ k hpre, hc]
  simp [classSize.firstAtLeast, hhi]

