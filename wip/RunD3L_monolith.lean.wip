import FvModexp.Proofs.Arm64.Top.RunD2Lem
import FvModexp.Proofs.Arm64.Top.RunD3J

/-! # `Run` (arm64): `D1` to `J2`, exponent operand longer than the input rest, more than 32 bytes: `makeslice` buffer,
`memmove` (at least one input byte to copy) -/

open Janus Janus.Arm64 Janus.GoABI Janus.Tactic Janus.Spec Janus.Contracts

namespace FvModexp.Arm64.Run

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem d3l (impl : List Segment) (hap : ImplApart Extracted.program impl) (R : RtInv)
    (hmk : MakesliceLiveContract (Extracted.program.ofImpl impl) (cA "runtime.makeslice") 4096 R)
    (hmv : MemmoveLive (Extracted.program.ofImpl impl) (cA "runtime.memmove") 4096 R)
    (hokS : ∀ n, n ≤ 128 → R.ok (cA "runtime.makeslice") [SetBytes.wordT, n, makeCap n])
    (b : Nat) (L : List (Nat × Nat)) (c p len cp : BitVec 64) (ret : Nat)
    (hret : RetAddr (LibRun.program.link impl) ret) (s : State)
    (henv : CallEnv R L s stk 40) (hin : InputOK R L c p len cp s) (Q : Outcome → Prop)
    (hbudD : 3 * makeCost 4 + 3 * dCost ≤ b)
    (S : State) (L1 : List (Nat × Nat)) (b1 : Nat) (hrel : RelD R b L c p len cp s ret 2 L1 b1 S)
    (hpc : S.pc = BitVec.ofNat 64 pcD2)
    (hndir : len.toNat - 96 < min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) + hdrV s p len 2) (hlg : 32 < hdrV s p len 2)
    (hn0 : 0 < len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96))
    (hokB : ∀ n, n ≤ 1024 → R.ok (cA "runtime.makeslice") [uint8T, n, n])
    (hokM : ∀ d sr n, n ≤ 2 ^ 20 → R.ok (cA "runtime.memmove") [d, sr, n])
    (hk : ∀ S2 L2 b2, RelD R b L c p len cp s ret 3 L2 b2 S2 →
      (S2.regs 0).toNat = S2.mem.readLE (s.sp.toNat - 192) 8 → (S2.regs 1).toNat = S2.mem.readLE (s.sp.toNat - 184) 8 →
      S2.pc = BitVec.ofNat 64 pcD3 →
      Reaches ((LibRun.program.link impl).withExit ret) S2 Q) :
    Reaches ((LibRun.program.link impl).withExit ret) S Q := by
  have henv0 := henv
  obtain ⟨⟨hg1, hg2, hg3⟩, ⟨hal, hb', ha, hw⟩, hd, hout, hga, hgr, hLs, hro⟩ := henv
  have hin0 := hin
  obtain ⟨hcacc, hc48, hcheld, hcw, hp, hlcp, hcp48, hpacc, hheld, hpw⟩ := hin
  obtain ⟨hsp, h28, h29, h18, hm1, hm2, hm3, hm4, hm5, hm6, hs1, hs2, hs3, hs4, hs5, hs6, hl0, hl1, hl2, hnz, hk1, hk2,
    hdS, hinS, hcS, hext, hbud, hinv, hLsS, hMF, hLF, hop, hopA⟩ := hrel
  obtain ⟨hk1a, hk1b⟩ := hk1 (by omega)
  have hk2a := hk2 (by omega)
  have hS1n : (if len.toNat - 96 < hdrV s p len 1 + hdrV s p len 0 then len.toNat - 96 else hdrV s p len 1 + hdrV s p len 0) =
      min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) := by split <;> omega
  have hS1 : (if len.toNat - 96 < hdrV s p len 1 + hdrV s p len 0 then BitVec.ofNat 64 (len.toNat - 96)
      else BitVec.ofNat 64 (hdrV s p len 1 + hdrV s p len 0)) = BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) := by
    rw [← hS1n, apply_ite (BitVec.ofNat 64)]
  have hadd : BitVec.ofNat 64 (hdrV s p len 2) + BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) =
      BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) + hdrV s p len 2) := bv_add_of_lt _ _ (by omega)
  have hmod : (hdrV s p len 2 + min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) % 18446744073709551616 = min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) + hdrV s p len 2 := by
    rw [Nat.mod_eq_of_lt (by omega)]; omega
  have hap1 := hap.1
  have hLs0 := hLsS
  simp only [stk] at hg3 hb' ha hw hout hga hLs hpw hcw hLsS hMF
  simp only [win, Outside, and_true] at hpw hcw
  have hgS : S.mem.readLE ((s.regs 28).toNat + 16) 8 = s.mem.readLE ((s.regs 28).toNat + 16) 8 :=
    hMF.readLE _ _ (by
      simp only [winA, Janus.outside_append, Janus.outside_cons, Janus.outside_nil, and_true]
      unfold Apart at hga; exact ⟨hgr, by omega, by omega⟩)
  have hwS : S.mem.accessible (s.sp.toNat - 4800) (4800 + 40) true = true := by rw [hMF.accessible]; exact hw
  have hspn : S.sp.toNat = s.sp.toNat - 624 := by rw [hsp, BitVec.toNat_sub]; simp; omega
  unfold Apart at hga
  have hwT : Outside SetBytes.wordT 16 R.rt := RoOut.out' hro 1 (by decide) (by decide)
  janus_eval_nat h_t : SetBytes.wordT
  rw [h_t] at hwT hokS
  have hLS1 : ∀ r ∈ L1, r.fst + (r.snd - r.fst) ≤ BitVec.toNat s.sp - 624 - 4160 ∨ BitVec.toNat s.sp - 624 + 48 ≤ r.fst := by
    intro r hr; have := hLsS r hr; simp only [Outside, and_true] at this; omega
  have hS := RunCallees.sbFixD impl hap R hmk b1 L1
  have hMC0 : makeCost (SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2))) ≤ allocCost (8 * 132) := by
    have h1 : SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2)) ≤ 128 := by simp [SetBytes.nW]; omega
    have h3 : makeCap (SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2))) ≤ 132 := by unfold makeCap; split <;> omega
    simp only [makeCost, allocCost]; omega
  have hMC : makeCost (SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2))) ≤ b1 := by
    simp only [dCost, allocCost] at hbudD hbud hMC0 ⊢; omega
  have hokm : R.ok (cA "runtime.makeslice") [2641088, SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2)),
      makeCap (SetBytes.nW (BitVec.ofNat 64 (hdrV s p len 2)))] := hokS _ (by simp [SetBytes.nW]; omega)
  have hmv' : MemmoveLive (LibRun.program.link impl) (cA "runtime.memmove") 4096 R :=
    MemmoveLive.of_codeIn (by rw [LibRun.eq_only]; exact codeIn_ofImpl_restrict_of_apart hap LibRun.names) hmv
  have hc : (len.toNat - 96 < min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) + hdrV s p len 2) = True := by simp; omega
  have hc32 : (32 < hdrV s p len 2) = True := by simp; omega
  have hIe := toInt_small (BitVec.ofNat 64 (hdrV s p len 2)) (by simp; omega)
  obtain ⟨off, hoffd⟩ : ∃ off, inOff len = off := ⟨_, rfl⟩
  have hoffc : (96 < len.toNat ∧ off = 96) ∨ (len.toNat ≤ 96 ∧ off = 0) := by
    subst hoffd; simp only [inOff]; split <;> omega
  rw [hoffd] at hs5 hs6
  have hcap : min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) ≤ cp.toNat - off := by omega
  obtain ⟨mN, hmNd⟩ : ∃ mN, (if min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) < cp.toNat - off then
      min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) else 0) = mN := ⟨_, rfl⟩
  have hmN : mN ≤ min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) ∧
      (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) = 0 ∨ mN = min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) := by
    subst hmNd; split <;> omega
  have hmask : (BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) &&&
      (BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) - BitVec.ofNat 64 (cp.toNat - off)).sshiftRight 63) =
      BitVec.ofNat 64 mN := by
    apply BitVec.eq_of_toNat_eq
    rw [sliceMask_le _ _ hcap (by omega), hmNd, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  have hsub : BitVec.ofNat 64 (len.toNat - 96) - BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) =
      BitVec.ofNat 64 (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) := by
    apply BitVec.eq_of_toNat_eq; rw [BitVec.toNat_sub]; simp only [BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (a := min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) (by omega),
      Nat.mod_eq_of_lt (a := len.toNat - 96) (by omega),
      Nat.mod_eq_of_lt (a := len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) (by omega)]; omega
  have hcsub : BitVec.ofNat 64 (cp.toNat - off) - BitVec.ofNat 64 (min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) =
      BitVec.ofNat 64 (cp.toNat - off - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) := by
    apply BitVec.eq_of_toNat_eq; rw [BitVec.toNat_sub]; simp only [BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (a := min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) (by omega),
      Nat.mod_eq_of_lt (a := cp.toNat - off) (by omega),
      Nat.mod_eq_of_lt (a := cp.toNat - off - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) (by omega)]; omega
  have hsrc : BitVec.ofNat 64 mN + BitVec.ofNat 64 (p.toNat + off) = BitVec.ofNat 64 (p.toNat + off + mN) := by
    apply BitVec.eq_of_toNat_eq; rw [BitVec.toNat_add]; simp only [BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (a := mN) (by omega), Nat.mod_eq_of_lt (a := p.toNat + off) (by omega),
      Nat.mod_eq_of_lt (a := p.toNat + off + mN) (by omega)]; omega
  have hIa := toInt_small (BitVec.ofNat 64 (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96))) (by simp; omega)
  have hmk' : MakesliceLiveContract (LibRun.program.link impl) (cA "runtime.makeslice") 4096 R :=
    MakesliceLiveContract.of_codeIn (by rw [LibRun.eq_only]; exact codeIn_ofImpl_restrict_of_apart hap LibRun.names) hmk
  have hmkP := hmk'.pos L1 b1
  janus_eval_nat h_u : uint8T
  have hokb : R.ok (cA "runtime.makeslice") [uint8T, hdrV s p len 2, hdrV s p len 2] := hokB _ (by omega)
  rw [h_u] at hokb
  have hU1 : s.mem.accessible 2639168 16 false = true := by
    janus_data hd; exact Memory.accessible_mono _ h_data0 (by omega) (by omega)
  have hU2 : S.mem.readLE 2639168 8 = 1 := by
    janus_data hdS; rw [h_rodata _ _ (by decide)]; decide
  have hU3 : S.mem.readLE 2639176 8 = 0 := by
    janus_data hdS; rw [h_rodata _ _ (by decide)]; decide
  have hut : Apart 2639168 16 (s.sp.toNat - 4800) (4800 + 40) :=
    apart_of_data (x := 2639168) (l := 16) hdS 0 (by decide) (by decide) hwS
  unfold Apart at hut
  have hBS : blockSize (hdrV s p len 2) true ≤ b1 := by
    have := blockSize_le_allocCost (hdrV s p len 2) true
    simp only [allocCost, dCost, makeCost, makeCap] at this hbudD hbud ⊢; omega
  set_option janus.callRegions true in
  janus_run [hm1, hm2, hm3, hm4, hm5, hm6, hs1, hs2, hs3, hs4, hs5, hs6, hk1a, hk1b, hk2a, hS1, hS1n, hadd, hmod, hc, hc32, hIe, hIa, hmask, hsub,
    hcsub, hsrc, hU2, hU3, toInt_ite, toNat_ite, toInt_small] until [segAddr Extracted.program fn + 0x6f8] calls [hmkP]
  rename_i ptr _ _ _ mk _ _ hLFk hMFk hapk hink hbk hack h8k h16k hzk hrk hapSk hinvk
  have hdk := dataLoaded_win (lo := s.sp.toNat - 4800) (n := 4800 + 40) ?d0 (by rw [hrg1]; simp) hro hMFk ?wacc ?ws
  case d0 => janus_callpre
  case wacc => simpa only [Memory.accessible_writeLE] using hwS
  case ws =>
    intro r hr
    simp only [calleeStack, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl <;> refine ⟨?_, ?_, ?_⟩ <;> dsimp only <;> omega
  clear hdS hinv
  have hmE : mN = min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) := by omega
  have hoff : off = 96 := by omega
  have hmvok : R.ok (cA "runtime.memmove") [ptr.toNat, p.toNat + off + mN,
      len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)] := hokM _ _ _ (by omega)
  have hsA : s.mem.accessible (p.toNat + off + mN) (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) false
      = true := Memory.accessible_mono _ hpacc (by omega) (by omega)
  have hpo : ptr.toNat + blockSize (hdrV s p len 2) true ≤ s.sp.toNat - 4800 ∨ s.sp.toNat + 40 ≤ ptr.toNat := by
    have := InRanges.apart hink hout; unfold Apart at this; omega
  have hpI : p.toNat + off + mN + (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) ≤ ptr.toNat ∨
      ptr.toNat + blockSize (hdrV s p len 2) true ≤ p.toNat + off + mN := by
    rcases hext.held (hheld.sub (a := p.toNat + off + mN)
      (n := len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) (by omega) (by omega)) with h | h
    · have := hapk.apart_of_inRanges h; unfold Apart at this; omega
    · have := InRanges.apart hink h; unfold Apart at this; omega
  have hne : (ptr.toNat = p.toNat + off + mN) = False := by simp only [eq_iff_iff, iff_false]; omega
  have hne' : (p.toNat + off + mN = ptr.toNat) = False := by simp only [eq_iff_iff, iff_false]; omega
  set_option janus.callRegions true in
  janus_run [hm1, hm2, hm3, hm4, hm5, hm6, hs1, hs2, hs3, hs4, hs5, hs6, hk1a, hk1b, hk2a, hS1, hS1n, hadd, hmod, hc, hc32, hIe, hIa, hne, hne',
    toInt_ite, toNat_ite, toInt_small] until [segAddr Extracted.program fn + 0x728] calls [hmv']
  rename_i m2 _ _ hMFm hLFm hinvm hcp
  have hlr : len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) ≤ blockSize (hdrV s p len 2) true := by omega
  have hink' : InRanges ptr.toNat (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)) R.rt :=
    hink.sub (Nat.le_refl _) (by omega)
  have hm : ∀ a n w, mk.accessible a n w = s.mem.accessible a n w := fun a n w => by
    simp only [hMFk.accessible, Memory.accessible_writeLE, hMF.accessible]
  have hdk' : Extracted.program.DataLoaded (mk.writeLE (BitVec.toNat s.sp - 264) 8 (BitVec.toNat ptr)) :=
    hdk.writeLE (by rw [hm]; exact Memory.accessible_mono _ hw (by omega) (by omega))
  have hMFm' := hMFm
  rw [List.append_assoc] at hMFm'
  have hd2 : Extracted.program.DataLoaded m2 := by
    refine dataLoaded_frame hdk' (by rw [hrg2]; simp) hro hMFm' fun r hr _ => ?_
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
    simp only [Memory.accessible_writeLE]
    rcases hr with (rfl | rfl) | rfl
    · rw [hm]; exact Memory.accessible_mono _ hw (by omega) (by omega)
    · rw [hm]; exact Memory.accessible_mono _ hw (by omega) (by omega)
    · rw [hm]; exact Memory.accessible_mono _ hack (Nat.le_refl _)
        (by dsimp only; rw [Nat.add_sub_cancel_left]; exact Nat.add_le_add_left hlr _)
  janus_run [hm1, hm2, hm3, hm4, hm5, hm6, hs1, hs2, hs3, hs4, hs5, hs6, hk1a, hk1b, hk2a, hS1, hS1n, hadd, hmod, hk2a, hS1, hS1n, hadd, hmod] until [pcJ3]
  have hstk : stk = 4800 := rfl
  have hLsL1 : LiveSep L1 (win s 4800 40) := hLs0
  have hext' : LiveExt R L1 (L1 ++ [(ptr.toNat, ptr.toNat + blockSize (hdrV s p len 2) true)]) :=
    LiveExt.single (by simpa using hink) (by simpa using hapk)
  have hMF2 : MemFrame s.mem m2 (R.rt ++ winA s stk 40) := by
    simp only [winA, stk] at hMF ⊢
    refine (((hMF.trans ?w1 fun a n h => ⟨h, out_wA h⟩).trans hMFk fun a n h => ⟨h, out_cs hb' h⟩).trans ?w2
      fun a n h => ⟨h, out_wA h⟩).trans hMFm fun a n h => ⟨h, out_csd hb' hink' h⟩
    case w1 => janus_frame
    case w2 => janus_frame
  have hdst : LiveSep L1 [(ptr.toNat, ptr.toNat + (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)))] := by
    intro r hr; have := hapk r hr; unfold Apart at this
    simp only [Janus.outside_cons, Janus.outside_nil, and_true]; omega
  have hLFS : LiveFrame S.mem m2 L1 [] :=
    (((LiveFrame.of_win (by simp only [win, stk]; janus_frame) hLsL1).trans hLFk (fun _ _ h => h)).trans
      (LiveFrame.of_win (by simp only [win, stk]; janus_frame) hLsL1) (fun _ _ h => h)).trans
      (LiveFrame.drop (L := L1) ⟨fun a n h hw => hLFm.readLE a n (h.append_left _) hw⟩ hdst) (fun _ _ h => h)
  have hLF2 : LiveFrame s.mem m2 L [] := hLF.trans hLFS (fun _ _ h => hext.inRanges_old h)
  have hLx := LiveFrame.of_nil' hLF2 (winA s stk 40)
  have hpo' : Outside p.toNat len.toNat (winA s stk 40) := by
    simp only [winA, stk, Janus.outside_cons, Janus.outside_nil, and_true]; omega
  have hco' : Outside c.toNat 3 (winA s stk 40) := by
    simp only [winA, stk, Janus.outside_cons, Janus.outside_nil, and_true]; omega
  refine d3join impl hap R hmk hokS b L c p len cp ret hret s henv0 hin0 Q hbudD hk _
    (L1 ++ [(ptr.toNat, ptr.toNat + blockSize (hdrV s p len 2) true)]) (b1 - blockSize (hdrV s p len 2) true) ptr.toNat
    ?hj (by janus_simp)
  case hj =>
  refine ⟨by janus_simp [hsp], by janus_simp [h28], by janus_simp [h29], by janus_simp [h18],
     by janus_simp [hm1], by janus_simp [hm2], by janus_simp [hm3], by janus_simp [hm4], by janus_simp [hm5],
     by janus_simp [hm6], by janus_simp [hs1], by janus_simp [hs2], by janus_simp [hs3], by janus_simp [hs4],
     by janus_simp [hs5, hoffd], by janus_simp [hs6, hoffd], by janus_simp [hk1a], by janus_simp [hk1b], by janus_simp [hk2a],
     by janus_simp, by janus_simp, by janus_simp, hl0, hl1, hl2, hnz,
     by janus_simp, (by janus_simp [hs3] <;> omega), by omega,
     (Memory.accessible_read_of_write _ (Memory.accessible_mono _ hack (Nat.le_refl _) (by omega))), ?held, (by omega),
     ?bytes, hd2, fun a n h1 h2 => (hheld.sub h1 h2).readLE hMF2 hLx (hpo'.of_sub h1 (by omega)),
     hcheld.readLE hMF2 hLx hco', hext.trans hext',
     (by have hBS' := blockSize_le_allocCost (hdrV s p len 2) true
         simp only [dCost, allocCost] at hbud hBS' ⊢; omega), hinvm, ?ls, hMF2, hLF2,
     OpDone.transport (hop 0 (by omega)) (by janus_simp [opAt]) (by janus_simp [opAt]) (by janus_simp [opAt])
       (by janus_simp [opAt]) hLFS (fun _ _ h => hext'.inRanges_old h),
     OpDone.transport (hop 1 (by omega)) (by janus_simp [opAt]) (by janus_simp [opAt]) (by janus_simp [opAt])
       (by janus_simp [opAt]) hLFS (fun _ _ h => hext'.inRanges_old h), OpsApart.transport hopA (fun i hi => by
       rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl <;> exact ⟨by janus_simp [opAt], by janus_simp [opAt]⟩)⟩
  case held => exact Or.inl ⟨_, List.mem_append_right _ (List.mem_singleton_self _), by dsimp only; omega, by dsimp only; omega⟩
  case ls =>
    intro r hr
    rcases List.mem_append.1 hr with hr | hr
    · exact hLsL1 r hr
    · simp only [List.mem_singleton] at hr; subst hr
      simp only [win, stk, Janus.outside_cons, Janus.outside_nil, and_true]; omega
  case bytes =>
    intro j hj
    have hLFw : LiveFrame (mk.writeLE (BitVec.toNat s.sp - 264) 8 (BitVec.toNat ptr)) m2
        (L1 ++ [(ptr.toNat, ptr.toNat + blockSize (hdrV s p len 2) true)])
        ([(BitVec.toNat s.sp - 624 - 4096, BitVec.toNat s.sp - 624 - 8),
          (BitVec.toNat s.sp - 624 + 8, BitVec.toNat s.sp - 624 + 8 + 24)] ++
          [(BitVec.toNat ptr, BitVec.toNat ptr + (len.toNat - 96 - min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96)))]) :=
      ⟨fun a n h ho => hLFm.readLE a n h (by simp only [Janus.outside_append] at ho; exact ho.2)⟩
    unfold padByte
    split
    · rename_i hjl
      have hcj := hcp j (by omega)
      rw [hcj, ← Memory.readLE_one, hmE, hoff]
      have hmin : min (hdrV s p len 1 + hdrV s p len 0) (len.toNat - 96) = hdrV s p len 0 := by omega
      rw [hmin]
      have hH : Held R (L1 ++ [(ptr.toNat, ptr.toNat + blockSize (hdrV s p len 2) true)])
          (p.toNat + 96 + (hdrV s p len 0 + hdrV s p len 1) + j) 1 :=
        (hext.trans hext').held (hheld.sub (by omega) (by omega))
      rw [← hH.readLE hMFm' hLFw (by
        simp only [Janus.outside_append, Janus.outside_cons, Janus.outside_nil, and_true]
        refine ⟨⟨by omega, by omega⟩, ?_⟩
        rcases hext.held (hheld.sub (a := p.toNat + 96 + (hdrV s p len 0 + hdrV s p len 1) + j) (n := 1) (by omega) (by omega)) with h | h
        · have := hapk.apart_of_inRanges h; unfold Apart at this; omega
        · have := InRanges.apart hink h; unfold Apart at this; omega)]
      rw [(hheld.sub (a := p.toNat + 96 + (hdrV s p len 0 + hdrV s p len 1) + j) (n := 1) (by omega) (by omega)).readLE hMF2 hLx
        (hpo'.of_sub (by omega) (by omega)), Memory.readLE_one,
        show p.toNat + 96 + (hdrV s p len 0 + hdrV s p len 1) + j = p.toNat + (96 + (hdrV s p len 0 + hdrV s p len 1) + j) by omega]
    · rename_i hjl
      rw [← Memory.readLE_one, hLFw.readLE _ _ ⟨_, List.mem_append_right _ (List.mem_singleton_self _),
        by dsimp only; omega, by dsimp only; omega⟩ (by
          simp only [Janus.outside_append, Janus.outside_cons, Janus.outside_nil, and_true]
          refine ⟨⟨by omega, by omega⟩, by omega⟩),
        Memory.readLE_writeLE_of_disjoint _ _ (by omega), Memory.readLE_one, hzk j hj]
      rfl

end FvModexp.Arm64.Run
