import FvModexp.Proofs.Amd64.Nat.DivBasicRec

set_option autoImplicit false

/-!
# `divBasic` (amd64): `pro3` — from `stk.nat`'s return to the loop head (`Hd`), composing `recRun` (the run on a
small context) with the pure memory facts of `recMem`.
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.GoABI0 Janus.Amd64.Tactic Janus.Spec Janus.Contracts
open FvModexp.Amd64.Callees Janus.Contracts.EqHashModel

namespace FvModexp.Amd64.DivBasic

set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
set_option linter.janusRenameI false in
/-- after `stk.nat` returned (`S2`): `vn1 := v[n-1]`, the inlined `reciprocalWord`, `j := m`, `ujn := 0` → the head -/
theorem pro3 (impl : List Amd64.Segment) (R : RtInv)
    (b : Nat) (L : List (Nat × Nat)) (qp ql st up ul uc : BitVec 64) (vp vl : Nat) (s : State)
    (hpre : Pre R b L qp.toNat ql.toNat st.toNat up.toNat ul.toNat uc.toNat vp vl s)
    (hx15s : s.xmm 15 = 0#128) (hdfs : s.df = false) (hra : s.mem.readLE (s.regs 4).toNat 8 < 2 ^ 47)
    (P : State) (hP : AtNat R b L qp.toNat ql.toNat st.toNat up.toNat ul.toNat uc.toNat vp vl s P)
    (S2 : State) (L1 : List (Nat × Nat)) (b1 : Nat)
    (hA : AfterNat R b L st.toNat vl s P S2 L1 b1) (Q : State → Prop)
    (k : ∀ S t w1 c1, Hd R b L qp.toNat ql.toNat st.toNat up.toNat ul.toNat uc.toNat vp vl
      (s.mem.readLE ((s.regs 4).toNat + 24) 8) s t L1 b1 w1 c1 S (ul.toNat + 2 ^ 64 - vl) 0 →
      (∀ a n, (qp.toNat ≤ a ∧ a + n ≤ qp.toNat + 8 * ql.toNat) ∨ (up.toNat ≤ a ∧ a + n ≤ up.toNat + 8 * ul.toNat) →
        S.mem.readLE a n = s.mem.readLE a n) →
      ReachesRet (LibDivBasic.program.link impl) (retAddrOf s) S Q) :
    ReachesRet (LibDivBasic.program.link impl) (retAddrOf s) S2 Q := by
  obtain ⟨-, -, -, -, -, -, -, -, -, hF, hreg, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13⟩ := hP
  obtain ⟨hpc2, hsp2, h52, h142, hfs2, hx152, hdf2, hr0, hr3, hr1, hext, hbud, hinv2, hok, hlen2, hsame, hgrow, hF2,
    hLF2, hmem⟩ := hA
  -- no `% 2^64` terms in the context of the omega calls below (SPEED LESSONS)
  have hmmlt : (ul.toNat + 2 ^ 64 - vl) % 2 ^ 64 < 2 ^ 64 := Nat.mod_lt _ (by omega)
  have hR2 : BitVec.ofNat 64 ((ul.toNat + 2 ^ 64 - vl) % 2 ^ 64) = BitVec.ofNat 64 (ul.toNat + 2 ^ 64 - vl) := by
    apply BitVec.eq_of_toNat_eq; simp only [BitVec.toNat_ofNat, Nat.mod_mod]
  have hmmF : ∀ x, x = P.mem.readLE ((s.regs 4).toNat - 104) 8 → x = (ul.toNat + 2 ^ 64 - vl) % 2 ^ 64 :=
    fun x h => h.trans p3
  generalize (ul.toNat + 2 ^ 64 - vl) % 2 ^ 64 = mm at p3 hmmlt hR2
  obtain ⟨-, ⟨hb', ha, hw⟩, -, -, hout, hga, hgr, hLs, -, ⟨-, -, htg⟩, -, htw⟩ := hpre.ce
  simp only [regSP, regG] at hb' ha hw htg
  unfold Apart at htw hga
  have hsw := hpre.stw; simp only [win, outside_cons, outside_nil, and_true] at hsw
  have hfw := hpre.stfw; simp only [win, outside_cons, outside_nil, and_true, freeP, freeN] at hfw
  have hlc := hpre.stok.2.2.2.2.2.1
  have hPs : ∀ a n, (a + n ≤ (s.regs 4).toNat - 137 ∨ (s.regs 4).toNat + 88 ≤ a ∨
      ((s.regs 4).toNat ≤ a ∧ a + n ≤ (s.regs 4).toNat + 32)) → P.mem.readLE a n = s.mem.readLE a n :=
    fun a n h => hF.readLE _ _ (by simp only [proWs, outside_cons, outside_nil, and_true]; omega)
  have hE := env_of (S2 := S2.mem) hpre hext hbud hok hlen2 hsame hgrow
    (fun a n v => by rw [hF2.accessible, Janus.Arm64.Memory.accessible_writeLE, hF.accessible]) hmem hx15s hdfs hra
  have hl := hE.lay
  have hsp0 := hl.sp0; have hsp1 := hl.sp1; have hv2 := hl.v2; have hvb := hl.vb; have hv48 := hl.v48
  -- reads of `S2.mem` in the frame (above the callee's window `[sp-4424, sp-208)`)
  have k2 : ∀ a n, (s.regs 4).toNat - 208 ≤ a → a + n ≤ (s.regs 4).toNat + 88 → S2.mem.readLE a n = P.mem.readLE a n := by
    intro a n h1 h2
    rw [hF2.readLE _ _ ?_, Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega)]
    simp only [stkWs, outside_append, outside_cons, outside_nil, and_true]
    exact ⟨⟨hout.of_sub (by omega) (by omega), by omega⟩, by omega, by omega⟩
  -- `v` in `S2.mem`
  have hvS : ∀ a n, vp ≤ a → a + n ≤ vp + 8 * vl → S2.mem.readLE a n = s.mem.readLE a n := by
    intro a n h1 h2
    have hvw := hl.vw
    have hfr := hpre.free.2.2; have hsv := hpre.stv
    simp only [freeP, freeN] at hfr
    unfold Apart at hfr hsv
    rw [Held.readLE2 (hpre.vh.sub h1 h2) hF2 hLF2
      (by simp only [outside_cons, outside_nil, and_true]; omega)
      (by simp only [stkWs, outside_cons, outside_nil, and_true]; omega),
      Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), hPs a n (by omega)]
  have q16 : S2.mem.readLE ((s.regs 4).toNat + 16) 8 = vl := by
    rw [k2 _ _ (by omega) (by omega), hPs _ _ (by omega)]; exact hpre.vlS
  have q8 : S2.mem.readLE ((s.regs 4).toNat + 8) 8 = vp := by
    rw [k2 _ _ (by omega) (by omega), hPs _ _ (by omega)]; exact hpre.vpS
  have qn1 := (k2 _ 8 (by omega) (by omega)).trans p4
  have qmm := (k2 _ 8 (by omega) (by omega)).trans p3
  have hvn1 := hvS (vp + 8 * (vl - 1)) 8 (by omega) (by omega)
  generalize hV : s.mem.readLE (vp + 8 * (vl - 1)) 8 = V at hvn1
  have hvtop : 2 ^ 63 ≤ V := by rw [← hV]; exact hpre.vtop
  have hV64 : V < 2 ^ 64 := by rw [← hV]; exact Janus.Arm64.Memory.readLE_lt _ _ _
  have hquS : ∀ a n, (qp.toNat ≤ a ∧ a + n ≤ qp.toNat + 8 * ql.toNat) ∨ (up.toNat ≤ a ∧ a + n ≤ up.toNat + 8 * ul.toNat) →
      S2.mem.readLE a n = s.mem.readLE a n := by
    intro a n h
    have hqw := hl.qw; have huw := hl.uw
    have hfq := hpre.free.1; have hfu := hpre.free.2.1; have hsq := hpre.stq; have hsu := hpre.stu
    simp only [freeP, freeN] at hfq hfu
    unfold Apart at hfq hfu hsq hsu
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [Held.readLE2 (hpre.qh.sub h1 h2) hF2 hLF2
        (by simp only [outside_cons, outside_nil, and_true]; omega)
        (by simp only [stkWs, outside_cons, outside_nil, and_true]; omega),
        Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), hPs a n (by omega)]
    · rw [Held.readLE2 (hpre.uh.sub h1 h2) hF2 hLF2
        (by simp only [outside_cons, outside_nil, and_true]; omega)
        (by simp only [stkWs, outside_cons, outside_nil, and_true]; omega),
        Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), hPs a n (by omega)]
  have hS2acc : ∀ a n v, S2.mem.accessible a n v = s.mem.accessible a n v := fun a n v => by
    rw [hF2.accessible, Janus.Arm64.Memory.accessible_writeLE, hF.accessible]
  have hvacc2 : S2.mem.accessible vp (8 * vl) false = true := by rw [hS2acc]; exact hpre.vacc
  have hwacc : S2.mem.accessible ((s.regs 4).toNat - 4424) (4424 + 88) true = true := by rw [hS2acc]; exact hw
  have hvn1'' : S2.mem.readLE (vp + vl * 8 - 8) 8 = V := by
    rw [show vp + vl * 8 - 8 = vp + 8 * (vl - 1) by omega]; exact hvn1
  have ht64 : stW S2.mem st.toNat + 8 * stLen s.mem st.toNat < 2 ^ 64 := by have := hl.t48; omega
  have hrl := FvModexp.AsmDivVW.recipWord_lt V (by omega) hV64
  refine recRun impl _ Q s S2 vp vl _ V _ hsp0 hsp1 hpc2 hsp2 hr0 hr1 hr3 hv2 hvb ht64 hv48 hwacc hvacc2 q16 q8 qn1 qmm
    hmmlt hvn1'' hvtop hV64 ?_
  intro S e0 e4 e5 e14 efs ex edf er0 er1 er2 er3 er6 er7 er8 er10 er11 em
  generalize hT : stW S2.mem st.toNat + 8 * stLen s.mem st.toNat = t at *
  have ht48 : t + 8 * (vl + 1) ≤ 2 ^ 48 := by have := hl.t48; omega
  -- reads of the head memory
  have rdR : ∀ a n, (a + n ≤ (s.regs 4).toNat - 136 ∨ (s.regs 4).toNat - 128 ≤ a) →
      (a + n ≤ (s.regs 4).toNat - 120 ∨ (s.regs 4).toNat - 112 ≤ a) →
      (a + n ≤ (s.regs 4).toNat - 72 ∨ (s.regs 4).toNat - 48 ≤ a) → S.mem.readLE a n = S2.mem.readLE a n := by
    intro a n h1 h2 h3
    rw [em]; simp only [recMem]
    rw [Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
      Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
      Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega)]
  have ks : ∀ a n, ((s.regs 4).toNat - 208 ≤ a ∧ a + n ≤ (s.regs 4).toNat - 136 ∨
      (s.regs 4).toNat - 104 ≤ a ∧ a + n ≤ (s.regs 4).toNat - 72 ∨
      (s.regs 4).toNat - 48 ≤ a ∧ a + n ≤ (s.regs 4).toNat + 88) → S.mem.readLE a n = P.mem.readLE a n := by
    intro a n h
    rw [rdR a n (by omega) (by omega) (by omega), k2 a n (by omega) (by omega)]
  have hS2 : MemFrame S2.mem S.mem [((s.regs 4).toNat - 136, (s.regs 4).toNat - 48)] :=
    ⟨fun a n h => by simp only [outside_cons, outside_nil, and_true] at h; exact rdR a n (by omega) (by omega) (by omega),
     fun a n v => by rw [em]; simp only [recMem, Janus.Arm64.Memory.accessible_writeLE]⟩
  have hW : MemFrame P.mem (P.mem.writeLE ((s.regs 4).toNat - 232) 8 raNat) [((s.regs 4).toNat - 232, (s.regs 4).toNat - 224)] :=
    ⟨fun a n h => by
      simp only [outside_cons, outside_nil, and_true] at h; exact Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
     fun a n v => by simp only [Janus.Arm64.Memory.accessible_writeLE]⟩
  have hwst := hl.sw
  refine k S t _ _ ⟨e0, by rw [e4, hsp2], by rw [e5, h52], by rw [e14, h142], by rw [efs, hfs2], by rw [ex, hx152],
    by rw [edf, hdf2], by rw [er0, hV], er1, ?r2, er3, er6, er7, by rw [er8]; rfl, er10, by rw [er11, hV], hE, ?mem⟩ ?qu
  case r2 => rw [er2, hR2]
  case qu =>
    intro a n h
    have hqw := hl.qw; have huw := hl.uw
    rw [rdR a n (by omega) (by omega) (by omega)]
    exact hquS a n h
  case mem =>
    refine ⟨?ra, (ks _ _ (by omega)).trans p1, (ks _ _ (by omega)).trans p2, ?rw, ?hl, ?mmf,
      ?vn, ?hc, ?tp, (ks _ _ (by omega)).trans p5, (ks _ _ (by omega)).trans p6, (ks _ _ (by omega)).trans p7,
      (ks _ _ (by omega)).trans p8, ?s7, ?s8, ?s9, (ks _ _ (by omega)).trans p9, (ks _ _ (by omega)).trans p10,
      (ks _ _ (by omega)).trans p11, (ks _ _ (by omega)).trans p12, (ks _ _ (by omega)).trans p13,
      ?hw, ?hlen, ?hcap, ?tls, ?vs, ?fr, ?lf, ?inv⟩
    case mmf => exact hmmF _ (ks _ _ (by omega))
    case ra => rw [ks _ _ (by omega), hPs _ _ (by omega)]
    case s7 => rw [ks _ _ (by omega), hPs _ _ (by omega)]; exact hpre.vpS
    case s8 => rw [ks _ _ (by omega), hPs _ _ (by omega)]; exact hpre.vlS
    case s9 => rw [ks _ _ (by omega), hPs _ _ (by omega)]
    case rw => rw [em, hV]; simp only [recMem, Janus.Arm64.Memory.readLE_writeLE_self]; exact Nat.mod_eq_of_lt hrl
    case hl =>
      rw [em]; simp only [recMem]
      rw [Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
        Janus.Arm64.Memory.readLE_writeLE_self]; exact Nat.mod_eq_of_lt (by omega)
    case vn =>
      rw [em, hV]; simp only [recMem]
      rw [Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
        Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
        Janus.Arm64.Memory.readLE_writeLE_self]; exact Nat.mod_eq_of_lt hV64
    case hc =>
      rw [em]; simp only [recMem]
      rw [Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
        Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_self]
      exact Nat.mod_eq_of_lt (by omega)
    case tp =>
      rw [em]; simp only [recMem]
      rw [Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega), Janus.Arm64.Memory.readLE_writeLE_self]
      exact Nat.mod_eq_of_lt (by omega)
    case hw => rw [rdR _ _ (by omega) (by omega) (by omega)]; rfl
    case hlen => rw [rdR _ _ (by omega) (by omega) (by omega)]; exact hlen2
    case hcap => rw [rdR _ _ (by omega) (by omega) (by omega)]; rfl
    case tls =>
      have htl := hl.tlw
      rw [rdR _ _ (by omega) (by omega) (by omega), hF2.readLE _ _ ?_, Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by omega),
        hPs _ _ (by omega), htg]
      have htr := hpre.ce.2.2.2.2.2.2.2.2.2.2.1
      have htlt := hl.tls
      simp only [stkWs, outside_append, outside_cons, outside_nil, and_true, freeP, freeN] at htr ⊢
      have := hpre.stft; simp only [freeP, freeN] at this; unfold Apart at this
      exact ⟨⟨htr, by omega⟩, by omega, by omega⟩
    case vs =>
      intro a n h1 h2
      rw [rdR a n (by omega) (by omega) (by omega)]
      exact hvS a n h1 h2
    case fr =>
      refine (mfTrans hF (mfTrans hW (mfTrans hF2 hS2))).mono fun a n ho => ?_
      simp only [win, stkWs, wsL, proWs, outside_append, outside_cons, outside_nil, and_true, and_assoc] at ho ⊢
      obtain ⟨hrt, h1, h2, h3, h4, h5, h6⟩ := ho
      refine ⟨?_, ?_, hrt, ?_, h5, h6, ?_⟩
      all_goals clear h2 h3 h4 h5 h6
      all_goals omega
    case lf =>
      refine ⟨fun a n hin hws => ?_⟩
      simp only [stkWs, wsL, outside_append, outside_cons, outside_nil, and_true] at hws
      obtain ⟨⟨h4, h5, h6⟩, h7, h8⟩ := hws
      have hw0 : a + n ≤ (s.regs 4).toNat - 4424 ∨ (s.regs 4).toNat + 88 ≤ a := by
        obtain ⟨r, hr, i1, i2⟩ := hin; have := hl.lsep r hr; clear h4 h5 h6 h7 h8; omega
      rw [rdR a n (by clear h4 h5 h6 h7 h8; omega) (by clear h4 h5 h6 h7 h8; omega) (by clear h4 h5 h6 h7 h8; omega),
        hLF2.readLE a n hin (by simp only [stkWs, outside_cons, outside_nil, and_true]; exact ⟨h7, h8⟩),
        Janus.Arm64.Memory.readLE_writeLE_of_disjoint _ _ (by clear h4 h5 h6 h7 h8; omega),
        hPs a n (by clear h4 h5 h6 h7 h8; omega)]
    case inv =>
      rw [em]; simp only [recMem]
      refine inv_store_out (inv_store_out (inv_store_out (inv_store_out (inv_store_out hinv2 ?_) ?_) ?_) ?_) ?_ <;>
        exact hout.of_sub (by omega) (by omega)

end FvModexp.Amd64.DivBasic
