import FvModexp.Proofs.Amd64.Nat.DivBasicRel
import FvModexp.Proofs.Amd64.Nat.DivBasicLay
import FvModexp.Proofs.Amd64.Nat.DivBasicCorr

set_option autoImplicit false

/-!
# `divBasic` (amd64): the loop head and the estimate `qhat` (natdiv.go:667-697)

`est`: from the head with `j ≥ 0` (`RDX = j`, `R8 = ujn`) to `mulPt = +0x26c` (`R8 = qhat`): `ujn == vn1` → `qhat = _M`
(`+0x265`); else `qhat, rhat := divWW(ujn, u[j+n-1], vn1, rec)` (`CALL +0x1e9`), `x1, x2 := mulWW(qhat, vn2)` (`MULQ`),
the correction loop (`corr`), `+0x59e` reloads the head registers. The value is `Mdl.qhatEst` (by `Mdl.qhatEst_eq`).
Writes only the slot `j` (`RSP-96`) and `divWW`'s return slot. The twin of `Arm64/Nat/DivBasicQh.lean`.
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.GoABI0 Janus.Amd64.Tactic Janus.Spec Janus.Contracts
open FvModexp.Amd64.Callees Janus.Contracts.EqHashModel

namespace FvModexp.Amd64.DivBasic

set_option maxRecDepth 20000 in
set_option maxHeartbeats 64000000 in
set_option linter.janusRenameI false in
theorem est (impl : List Amd64.Segment) (hap : Amd64.ImplApart Extracted.program impl) (R : RtInv)
    (b : Nat) (L : List (Nat × Nat)) (qp ql st up ul uc vp vl vc : Nat) (s : State)
    (t : Nat) (L1 : List (Nat × Nat)) (b1 w1 c1 : Nat) (S : State) (j ujn : Nat)
    (hH : Hd R b L qp ql st up ul uc vp vl vc s t L1 b1 w1 c1 S j ujn)
    (hj : j + vl ≤ ul) (hle : ujn ≤ s.mem.readLE (vp + 8 * (vl - 1)) 8) (Q : State → Prop)
    (k : ∀ S', AtMul s S S' vp vl t (AsmDiv.recipWord (s.mem.readLE (vp + 8 * (vl - 1)) 8))
      (s.mem.readLE (vp + 8 * (vl - 1)) 8) j
      (Mdl.qhatEst (s.mem.readLE (vp + 8 * (vl - 1)) 8) (s.mem.readLE (vp + 8 * (vl - 2)) 8)
      (Mdl.reciprocalWord (s.mem.readLE (vp + 8 * (vl - 1)) 8)) ujn (S.mem.readLE (up + 8 * (j + vl - 1)) 8)
      (S.mem.readLE (up + 8 * (j + vl - 2)) 8)) → ReachesRet (LibDivBasic.program.link impl) (retAddrOf s) S' Q) :
    ReachesRet (LibDivBasic.program.link impl) (retAddrOf s) S Q := by
  obtain ⟨hpc, hsp, h5, h14, hfs, hx15, hdf, hr0, hr1, hr2, hr3, hr6, hr7, hr8, hr10, hr11, hE, hM⟩ := hH
  have hl := hE.lay
  have hsp0 := hl.sp0; have hsp1 := hl.sp1; have hv2 := hl.v2; have hvb := hl.vb; have hv48 := hl.v48
  have hu48 := hl.u48; have ht48 := hl.t48
  have hub := hE.pre.ub
  have hvtop := hE.pre.vtop
  obtain ⟨-, ⟨hb', ha, hw⟩, -, -, -, -, -, -, -, -⟩ := hE.pre.ce
  simp only [regSP] at hb' ha hw
  have hMacc : ∀ a n v, S.mem.accessible a n v = s.mem.accessible a n v := fun a n v => hM.fr.accessible a n v
  have hwacc : S.mem.accessible ((s.regs 4).toNat - 4424) (4424 + 88) true = true := by rw [hMacc]; exact hw
  have huacc : S.mem.accessible up (8 * ul) false = true := by
    rw [hMacc]; exact Janus.Arm64.Memory.accessible_weaken _ hE.pre.uacc
  have hvacc : S.mem.accessible vp (8 * vl) false = true := by rw [hMacc]; exact hE.pre.vacc
  have m4 := hM.vn1; have m5 := hM.rw; have s4 := hM.s4; have s5 := hM.s5; have s7 := hM.s7; have s8 := hM.s8
  have mhl := hM.hl; have mhc := hM.hc; have mtp := hM.tp
  generalize hvn1 : s.mem.readLE (vp + 8 * (vl - 1)) 8 = vn1 at *
  have hvn1B : vn1 < 2 ^ 64 := by rw [← hvn1]; exact Janus.Arm64.Memory.readLE_lt _ _ _
  have hvn2 : S.mem.readLE (vp + vl * 8 - 16) 8 = s.mem.readLE (vp + 8 * (vl - 2)) 8 := by
    rw [show vp + vl * 8 - 16 = vp + 8 * (vl - 2) by omega]; exact hM.vs _ _ (by omega) (by omega)
  generalize hvn2' : s.mem.readLE (vp + 8 * (vl - 2)) 8 = vn2 at *
  have hvn2B : vn2 < 2 ^ 64 := by rw [← hvn2']; exact Janus.Arm64.Memory.readLE_lt _ _ _
  have hu1 : S.mem.readLE (up + (vl + j - 1) * 8) 8 = S.mem.readLE (up + 8 * (j + vl - 1)) 8 := by
    rw [show (vl + j - 1) * 8 = 8 * (j + vl - 1) by omega]
  have hu2 : S.mem.readLE (up + (j + vl - 2) * 8) 8 = S.mem.readLE (up + 8 * (j + vl - 2)) 8 := by rw [Nat.mul_comm]
  generalize hun1 : S.mem.readLE (up + 8 * (j + vl - 1)) 8 = un1 at *
  generalize hun2 : S.mem.readLE (up + 8 * (j + vl - 2)) 8 = un2 at *
  have hun1B : un1 < 2 ^ 64 := by rw [← hun1]; exact Janus.Arm64.Memory.readLE_lt _ _ _
  have hun2B : un2 < 2 ^ 64 := by rw [← hun2]; exact Janus.Arm64.Memory.readLE_lt _ _ _
  have hujnB : ujn < 2 ^ 64 := by omega
  have hjm : j % 2 ^ 64 = j := Nat.mod_eq_of_lt (by omega)
  have hj63 : (BitVec.ofNat 64 j).toInt = j := by
    rw [BitVec.toInt_ofNat]; omega
  have hqe := Mdl.qhatEst_eq vn1 vn2 ujn un1 un2 hvtop hvn1B hle hun1B
  rw [hqe] at k
  by_cases hq : ujn = vn1
  · subst hq
    simp only [ne_eq, not_true_eq_false, ↓reduceIte] at k
    janus64_run [hr0, hr1, hr2, hr3, hr6, hr7, hr8, hr10, hr11, hj63, hjm] until [mulPt]
    all_goals done
  · have hlt : ujn < vn1 := by omega
    simp only [ne_eq, hq, not_false_eq_true, ↓reduceIte] at k
    have hrcm : AsmDiv.recipWord vn1 % 18446744073709551616 = AsmDiv.recipWord vn1 :=
      Nat.mod_eq_of_lt (FvModexp.AsmDivVW.recipWord_lt vn1 (by omega) hvn1B)
    janus64_run [hr0, hr1, hr2, hr3, hr6, hr7, hr8, hr10, hr11, hj63, hjm, hu1, s4, s5, hrcm] until [callWW + 5]
      calls [divww impl hap]
    all_goals done

end FvModexp.Amd64.DivBasic
